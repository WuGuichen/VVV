.mx-attachment {
    position: relative;
    margin-top: 4px;
    margin-bottom: 5px;
}

.mx-attachment > Foldout > Toggle {
    min-height: 26px;
    -unity-font-style: bold;
    font-size: 13px;
}

.mx-attachment__reset {
    position: absolute;
    top: 1px;
    right: 4px;
    height: 22px;
    min-width: 70px;
    color: rgb(92, 157, 255);
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}

.mx-attachment__card {
    margin-top: 3px;
    margin-left: 3px;
    margin-right: 2px;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 10px;
    padding-bottom: 10px;
    background-color: rgb(37, 42, 47);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(59, 66, 72);
    border-right-color: rgb(59, 66, 72);
    border-top-color: rgb(59, 66, 72);
    border-bottom-color: rgb(59, 66, 72);
    border-radius: 4px;
}

.mx-attachment__section-title {
    min-height: 22px;
    -unity-font-style: bold;
    font-size: 13px;
    color: rgb(220, 224, 228);
}

.mx-attachment__segments {
    flex-direction: row;
    flex-grow: 1;
    min-height: 28px;
}

.mx-attachment__segments--inline {
    min-width: 220px;
}

.mx-attachment__segment {
    flex-grow: 1;
    min-width: 76px;
    height: 27px;
    margin-left: 0;
    margin-right: 1px;
    border-radius: 2px;
}

.mx-attachment__segment.is-selected,
.mx-attachment__uniform-scale.is-selected,
#mx-attachment-uniform-scale.is-selected {
    color: white;
    background-color: rgb(42, 105, 188);
    border-left-color: rgb(69, 144, 243);
    border-right-color: rgb(69, 144, 243);
    border-top-color: rgb(69, 144, 243);
    border-bottom-color: rgb(69, 144, 243);
}

.mx-attachment__helper {
    margin-top: 5px;
    color: rgb(157, 163, 169);
    white-space: normal;
    font-size: 11px;
}

.mx-attachment__divider {
    height: 1px;
    margin-top: 10px;
    margin-bottom: 9px;
    background-color: rgba(255, 255, 255, 0.09);
}

.mx-attachment__row {
    flex-direction: row;
    align-items: center;
    min-height: 30px;
    margin-bottom: 3px;
}

.mx-attachment__row-label {
    width: 92px;
    min-width: 92px;
    color: rgb(205, 209, 214);
}

.mx-attachment__socket-field {
    flex-grow: 1;
    min-width: 150px;
    margin-right: 4px;
}

.mx-attachment__validation {
    margin-left: 92px;
    margin-top: 1px;
    margin-bottom: 5px;
    font-size: 11px;
    white-space: normal;
}

.mx-attachment__validation--valid {
    color: rgb(106, 190, 92);
}

.mx-attachment__validation--warning {
    color: rgb(218, 168, 83);
}

.mx-attachment__transform-header {
    flex-direction: row;
    align-items: center;
    min-height: 28px;
    margin-bottom: 3px;
}

.mx-attachment__transform-header Button {
    height: 23px;
    min-width: 48px;
    margin-left: 3px;
}

.mx-attachment__axis {
    flex-grow: 1;
    min-width: 72px;
    margin-right: 4px;
}

.mx-attachment__axis .unity-base-field__label {
    min-width: 17px;
    width: 17px;
    margin-right: 2px;
    -unity-font-style: bold;
}

.mx-attachment__axis--x .unity-base-field__label {
    color: rgb(219, 100, 100);
}

.mx-attachment__axis--y .unity-base-field__label {
    color: rgb(100, 190, 108);
}

.mx-attachment__axis--z .unity-base-field__label {
    color: rgb(91, 145, 230);
}

.mx-attachment__unit {
    width: 18px;
    color: rgb(170, 174, 179);
    -unity-text-align: middle-center;
}

.mx-attachment__preview {
    flex-direction: row;
    align-items: center;
    min-height: 38px;
    margin-top: 9px;
    padding-left: 8px;
    padding-right: 6px;
    background-color: rgba(0, 0, 0, 0.18);
    border-radius: 3px;
}

.mx-attachment__preview-icon {
    width: 20px;
    color: rgb(73, 139, 238);
    font-size: 14px;
}

.mx-attachment__preview-text {
    flex-grow: 1;
    color: rgb(177, 182, 188);
    font-size: 11px;
    white-space: normal;
}

.mx-attachment__preview Button {
    height: 25px;
    min-width: 104px;
}
