<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
    <ui:VisualElement class="vfx-window">
        <ui:VisualElement class="topbar">
            <ui:Label text="✦  MxFramework / VFX 创作工作台" class="breadcrumb" />
            <ui:VisualElement class="mode-switch">
                <ui:Button name="library-mode" text="资源库" tooltip="浏览发布效果、配方与基础单元" class="mode-button" />
                <ui:Button name="creative-mode" text="创作实验室" tooltip="从创作简报生成受控候选" class="mode-button" />
            </ui:VisualElement>
            <ui:VisualElement name="studio-mode-switch" class="studio-mode-switch topbar-studio-switch">
                <ui:Button name="manual-studio-mode" text="手动组装" class="mode-button" />
                <ui:Button name="source-import-studio-mode" text="+ 添加素材" class="mode-button source-import-mode-button" />
                <ui:Button name="agent-studio-mode" text="Development Agent 创作" class="mode-button" />
            </ui:VisualElement>
            <ui:Button name="creative-reset" text="新建通用简报" tooltip="清空当前 Development Agent 简报" class="secondary-action topbar-creative-action" />
            <ui:VisualElement class="top-spacer" />
            <ui:Label name="coverage-badge" text="严格覆盖" class="badge badge--good" />
            <ui:Label name="production-coverage-badge" text="Production 0/0" class="badge badge--production" />
            <ui:Label name="diagnostic-badge" text="0 条诊断" class="badge" />
            <ui:Button name="reload" text="↻ 刷新" tooltip="重新加载语义目录、报告与缩略图证据" class="toolbar-action" />
            <ui:Button name="thumbnails" text="生成缩略图" tooltip="重新生成全部 VFX 缩略图" class="toolbar-action" />
            <ui:Button name="showcase" text="打开展示场景" tooltip="打开 VFX Showcase 验收场景" class="toolbar-action" />
            <ui:Button name="authoring-boundary-help" text="?" tooltip="制作边界：工作台只制作、预览并烘焙独立 VFX；技能与动作通过稳定 ResourceKey 选择和预览 VFX。" class="toolbar-action boundary-help-button" />
        </ui:VisualElement>

        <ui:VisualElement name="library-workspace" class="workspace library-workspace">
            <ui:VisualElement class="sidebar">
                <ui:Label text="VFX 资源库" class="section-title" />
                <ui:Label text="语义资产与复用证据" class="section-subtitle" />
                <uie:ToolbarSearchField name="search" class="search" />
                <ui:Label text="筛选" class="micro-title" />
                <ui:DropdownField name="role-filter" label="角色" class="filter" />
                <ui:DropdownField name="theme-filter" label="主题" class="filter" />
                <ui:DropdownField name="backend-filter" label="后端" class="filter" />
                <ui:DropdownField name="review-filter" label="评审" class="filter" />
                <ui:Label text="语义分组" class="micro-title groups-title" />
                <ui:ScrollView name="category-host" class="categories" />
            </ui:VisualElement>

            <ui:VisualElement name="center-pane" class="center-pane">
                <ui:VisualElement class="content-header">
                    <ui:Label name="center-title" text="发布效果" class="pane-title" />
                    <ui:Label name="center-subtitle" text="大图卡片 · 双击打开资源" class="subtle" />
                </ui:VisualElement>
                <ui:ListView name="effect-grid" class="effect-grid" selection-type="None" />
            </ui:VisualElement>

            <ui:VisualElement class="inspector-pane">
                <ui:VisualElement class="preview-toolbar">
                    <ui:Button name="play" text="▶" tooltip="播放" class="icon-button" />
                    <ui:Button name="pause" text="Ⅱ" tooltip="暂停" class="icon-button" />
                    <ui:Button name="stop" text="■" tooltip="停止并清空" class="icon-button" />
                    <ui:Button name="restart" text="↻" tooltip="从头重新播放" class="icon-button" />
                    <ui:Label name="playback-status" text="已停止" class="playback-status stopped" />
                    <ui:Toggle name="loop" label="循环" value="true" />
                    <ui:Slider name="speed" label="速度" low-value="0.1" high-value="2" value="1" />
                    <ui:DropdownField name="fallback-mode" choices="原始,Graph,降级" index="0" />
                </ui:VisualElement>
                <ui:VisualElement name="preview-host" class="preview-host" />
                <ui:VisualElement class="selection-header">
                    <ui:VisualElement class="selection-copy">
                        <ui:Label name="selection-title" text="请选择资源" class="selection-title" />
                        <ui:Label name="selection-id" class="subtle" />
                    </ui:VisualElement>
                    <ui:Label name="review-status" class="review-pill" />
                </ui:VisualElement>
                <ui:VisualElement class="tabs">
                    <ui:Button text="概览" class="vfx-tab" />
                    <ui:Button text="组合" class="vfx-tab active" />
                    <ui:Button text="参数" class="vfx-tab" />
                    <ui:Button text="依赖" class="vfx-tab" />
                    <ui:Button text="评审" class="vfx-tab" />
                </ui:VisualElement>
                <ui:ScrollView name="tab-content" mode="Vertical" horizontal-scroller-visibility="Hidden" class="tab-content" />
                <ui:VisualElement class="actions">
                    <ui:Button name="open-prefab" text="打开资源" />
                    <ui:Button name="open-showcase" text="打开展示场景" />
                    <ui:Button name="impact-analysis" text="复制影响分析" />
                </ui:VisualElement>
                <ui:VisualElement class="actions">
                    <ui:Button name="save-draft" text="保存语义目录草稿" class="draft" />
                    <ui:Button name="apply-change" text="应用语义目录变更" class="primary" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="creative-workspace" class="creative-workspace">
            <ui:VisualElement name="manual-studio-workspace" class="manual-workspace">
                <ui:VisualElement class="manual-draft-toolbar">
                    <ui:VisualElement name="composition-draft-current" class="manual-draft-current" tooltip="点击打开草稿浏览器">
                        <ui:VisualElement class="manual-draft-current-copy">
                            <ui:Label name="composition-draft-current-name" text="尚未选择草稿" class="manual-draft-current-name" />
                            <ui:Label name="composition-draft-current-id" text="创建或打开一个 Composition Draft" class="manual-draft-current-id" />
                            <ui:Label name="composition-draft-current-meta" text="" class="manual-draft-current-meta" />
                        </ui:VisualElement>
                        <ui:Label text="⌄" class="manual-draft-current-chevron" />
                    </ui:VisualElement>
                    <ui:Button name="composition-draft-browser-open" text="切换草稿" tooltip="搜索并切换项目内的 VFX 草稿" class="draft-browser-open" />
                    <ui:Button name="composition-new" text="新建" tooltip="创建空白 Composition Draft" />
                    <ui:Button name="composition-import-source-prefab" text="+ 添加素材" tooltip="从已索引的 Piloto Prefab 添加草稿本地 Compound Element" class="add-material-button" />
                    <ui:Button name="composition-open" text="打开" tooltip="从 Compositions 目录选择 JSON 草稿" />
                    <ui:Button name="composition-save" text="保存草稿" class="draft" />
                    <ui:Button name="composition-delete" text="删除草稿" tooltip="删除当前 Composition Draft 与本机恢复日志；不会删除 Candidate、Prefab 或已发布资源" class="destructive" />
                    <ui:Button name="composition-remap" text="重映射…" tooltip="检查 Source/Profile stale，并只应用稳定 ID 可证明的映射" />
                    <ui:VisualElement class="manual-draft-toolbar-spacer" />
                    <ui:VisualElement class="composition-state-strip">
                        <ui:Label name="composition-draft-save-state" text="草稿 尚未保存" class="composition-state-badge state-neutral" />
                        <ui:Label name="composition-prefab-sync-state" text="Prefab 未导出" class="composition-state-badge state-neutral" />
                        <ui:Label name="composition-publication-state" text="未发布" class="composition-state-badge state-neutral" />
                    </ui:VisualElement>
                    <ui:Label name="composition-save-status" text="尚未保存" class="composition-save-status" />
                </ui:VisualElement>
                <ui:VisualElement class="manual-body">
                    <ui:VisualElement class="manual-palette creative-panel">
                        <ui:VisualElement class="panel-heading-row">
                            <ui:VisualElement class="panel-heading-copy">
                                <ui:Label text="原材料 Element" class="panel-title" />
                                <ui:Label name="element-summary" text="等待加载精选目录" class="panel-subtitle" />
                            </ui:VisualElement>
                            <ui:Label name="element-visible-count" text="0 项" class="count-pill" />
                        </ui:VisualElement>
                        <uie:ToolbarSearchField name="element-search" class="search element-search" />
                        <ui:DropdownField name="element-source-filter" label="来源" class="source-filter" />
                        <ui:VisualElement class="element-filter-grid">
                            <ui:VisualElement class="element-filter-row">
                                <ui:DropdownField name="element-role-filter" label="职责" class="compact-filter" />
                                <ui:DropdownField name="element-theme-filter" label="主题" class="compact-filter" />
                                <ui:DropdownField name="element-family-filter" label="家族" class="compact-filter" />
                            </ui:VisualElement>
                            <ui:VisualElement class="element-filter-row">
                                <ui:DropdownField name="element-anchor-filter" label="Anchor" class="compact-filter" />
                                <ui:DropdownField name="element-quality-filter" label="质量档" class="compact-filter" />
                                <ui:DropdownField name="element-package-filter" label="Package" class="compact-filter" />
                            </ui:VisualElement>
                            <ui:VisualElement class="element-filter-row">
                                <ui:DropdownField name="element-shape-filter" label="形态" class="compact-filter" />
                                <ui:DropdownField name="element-lifecycle-filter" label="时序" class="compact-filter" />
                                <ui:DropdownField name="element-extraction-filter" label="提取" class="compact-filter" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:Foldout text="更多分类" value="false" class="element-taxonomy-foldout">
                            <ui:VisualElement class="element-filter-row">
                                <ui:DropdownField name="element-use-case-filter" label="用途" class="compact-filter" />
                                <ui:DropdownField name="element-motion-filter" label="运动" class="compact-filter" />
                                <ui:DropdownField name="element-timing-filter" label="节奏" class="compact-filter" />
                            </ui:VisualElement>
                            <ui:VisualElement class="element-filter-row">
                                <ui:DropdownField name="element-space-filter" label="模拟空间" class="compact-filter" />
                                <ui:DropdownField name="element-renderer-filter" label="渲染" class="compact-filter" />
                                <ui:DropdownField name="element-budget-filter" label="预算" class="compact-filter" />
                            </ui:VisualElement>
                            <ui:VisualElement class="element-filter-row">
                                <ui:DropdownField name="element-granularity-filter" label="粒度" class="compact-filter" />
                            </ui:VisualElement>
                        </ui:Foldout>
                        <ui:VisualElement name="element-index-unavailable" class="element-index-unavailable">
                            <ui:Label name="element-index-unavailable-status" text="版本化 Element 仍可浏览；深度操作需要 Source Index。" class="element-index-unavailable-status" />
                            <ui:Button name="element-index-rebuild" text="重建 Source Index" class="primary" />
                        </ui:VisualElement>
                        <ui:ListView name="element-list" class="element-list element-card-grid" selection-type="None" />
                        <ui:Label name="element-detail" text="请选择 Element" class="element-detail" />
                        <ui:Foldout name="element-semantic-editor" text="编辑组件信息（职责 / 主题 / 挂点）" tooltip="展开后可修正自动识别的组件语义；不会修改 Piloto 源资源" value="false" class="element-semantic-editor">
                            <ui:DropdownField name="element-semantic-member" label="成员组件" class="semantic-field" />
                            <ui:TextField name="element-semantic-name" label="卡片展示名" tooltip="直接控制素材卡片和 Layer Stack 中显示的中文名称" class="semantic-field" />
                            <ui:TextField name="element-semantic-member-name" label="成员名称" tooltip="组件策展名称；不会重命名 Piloto 源 GameObject" class="semantic-field" />
                            <ui:VisualElement class="semantic-field-row">
                                <ui:DropdownField name="element-semantic-role-primary" label="主要职责" class="semantic-field semantic-third" />
                                <ui:DropdownField name="element-semantic-role-secondary" label="辅助职责" class="semantic-field semantic-third" />
                                <ui:DropdownField name="element-semantic-role-tertiary" label="细节职责" class="semantic-field semantic-third" />
                            </ui:VisualElement>
                            <ui:VisualElement class="semantic-field-row">
                                <ui:DropdownField name="element-semantic-theme" label="主题" class="semantic-field semantic-third" />
                                <ui:DropdownField name="element-semantic-family" label="效果家族" class="semantic-field semantic-third" />
                                <ui:DropdownField name="element-semantic-shape" label="形态" class="semantic-field semantic-third" />
                            </ui:VisualElement>
                            <ui:VisualElement class="semantic-field-row">
                                <ui:DropdownField name="element-semantic-use-case-primary" label="主要用途" class="semantic-field semantic-third" />
                                <ui:DropdownField name="element-semantic-use-case-secondary" label="辅助用途" class="semantic-field semantic-third" />
                                <ui:DropdownField name="element-semantic-anchor" label="挂点" class="semantic-field semantic-third" />
                            </ui:VisualElement>
                            <ui:VisualElement class="semantic-field-row">
                                <ui:DropdownField name="element-semantic-timing" label="节奏阶段" class="semantic-field semantic-third" />
                                <ui:DropdownField name="element-semantic-motion" label="运动方式" class="semantic-field semantic-third" />
                                <ui:DropdownField name="element-semantic-quality" label="质量档" class="semantic-field semantic-third" />
                            </ui:VisualElement>
                            <ui:Label name="element-semantic-technical" text="技术事实" class="semantic-technical" />
                            <ui:VisualElement class="semantic-toggle-row">
                                <ui:Toggle name="element-semantic-preferred" label="设为首选代表" />
                                <ui:Toggle name="element-semantic-deprecated" label="弃用此组件" />
                            </ui:VisualElement>
                            <ui:TextField name="element-semantic-note" label="策展备注" multiline="true" class="semantic-field semantic-note" />
                            <ui:Label name="element-semantic-status" text="选择 Element 后可修正自动识别结果。" class="semantic-status" />
                            <ui:VisualElement class="semantic-action-row">
                                <ui:Button name="element-semantic-reset" text="恢复自动识别" tooltip="清空语义覆盖，但保留已有 Primitive 映射" />
                                <ui:Button name="element-semantic-save" text="保存并刷新" class="primary" />
                            </ui:VisualElement>
                        </ui:Foldout>
                        <ui:Button name="element-show-equivalents" text="显示等价来源" tooltip="查看被技术指纹折叠的其他 Piloto 源组件" />
                        <ui:Foldout text="原材料管理" value="false" class="source-admin">
                            <ui:Button name="element-rescan" text="重建全量 Source Index" />
                            <ui:Button name="element-curate" text="重建精选与完整去重索引" />
                            <ui:Button name="element-generate-previews" text="生成固定种子多时间点预览" />
                            <ui:Button name="element-generate-samples" text="生成通用示例草稿" />
                        </ui:Foldout>
                    </ui:VisualElement>

                    <ui:VisualElement class="manual-preview-pane creative-panel">
                        <ui:VisualElement class="composition-toolbar">
                            <ui:VisualElement class="panel-heading-copy preview-heading">
                                <ui:Label text="隔离组合预览" class="panel-title" />
                                <ui:Label text="seed 17 · 源资产只读" class="panel-subtitle" />
                            </ui:VisualElement>
                            <ui:Label name="composition-playback-status" text="已停止" class="playback-status stopped" />
                            <ui:VisualElement class="preview-toolbar-spacer" />
                            <ui:VisualElement class="preview-environment-group">
                                <ui:DropdownField name="composition-loop-mode" label="主体循环" class="toolbar-field environment-field loop-environment-field" />
                                <ui:DropdownField name="composition-background" label="背景" class="toolbar-field environment-field" />
                                <ui:DropdownField name="composition-post-processing" label="观感" tooltip="原始材质用于检查素材；游戏观感启用 URP Bloom、ACES Tonemapping、FXAA 与 Dithering" class="toolbar-field environment-field look-environment-field" />
                                <ui:DropdownField name="composition-camera" label="镜头" class="toolbar-field environment-field" />
                                <ui:Slider name="composition-speed" label="速度" low-value="0.1" high-value="2" value="1" class="speed-field" />
                            </ui:VisualElement>
                            <ui:VisualElement class="preview-spatial-inline">
                                <ui:Label text="空间" class="preview-inline-label" />
                                <ui:Toggle name="composition-grid" label="网格" value="true" />
                                <uie:Vector3Field name="composition-root-position" label="根" class="root-position-field root-position-inline" />
                                <ui:Button name="composition-root-reset" text="归零" tooltip="将预览根节点恢复到世界原点" />
                                <ui:Button name="composition-frame" text="适配镜头" tooltip="将全部可见层居中到相机" />
                                <ui:VisualElement class="legacy-camera-preset-bindings">
                                    <ui:Button name="composition-camera-perspective" text="透视" />
                                    <ui:Button name="composition-camera-top" text="俯视" />
                                    <ui:Button name="composition-camera-front" text="正面" />
                                    <ui:Button name="composition-camera-side" text="侧面" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                            <ui:Button name="composition-reset-layout" text="还原布局" tooltip="恢复预览、Layer Stack 和折叠面板的默认布局" class="preview-layout-button" />
                            <ui:Button name="composition-maximize-preview" text="最大化预览" tooltip="隐藏素材库、Inspector 和 Layer Stack，仅保留中央预览" class="preview-layout-button primary" />
                        </ui:VisualElement>
                        <ui:DropdownField name="composition-stage" label="生命周期阶段" style="display: none;" />
                        <ui:VisualElement class="composition-control-row">
                        <ui:VisualElement name="composition-phase-summary-strip" class="phase-summary-strip">
                            <ui:Label text="生命周期" class="phase-summary-title" />
                            <ui:Button name="composition-phase-summary-all" text="完整预览" tooltip="按 Build → Loop → Complete 的完整生命周期预览" class="phase-summary-item phase-summary-all" />
                            <ui:Button name="composition-phase-summary-build" text="构建 · 自动 0 帧" tooltip="Build：实例首次出现" class="phase-summary-item phase-summary-build" />
                            <ui:Button name="composition-phase-summary-rebuild" text="重建 · 自动 0 帧" tooltip="Rebuild：已有实例重新激活" class="phase-summary-item phase-summary-rebuild" />
                            <ui:Button name="composition-phase-summary-loop" text="循环 · 自动 1 帧" tooltip="Loop：效果主体播放段" class="phase-summary-item phase-summary-loop" />
                            <ui:Button name="composition-phase-summary-complete" text="完成 · 自动 0 帧" tooltip="Complete：自然完成退出" class="phase-summary-item phase-summary-complete" />
                            <ui:Button name="composition-phase-summary-dissipate" text="消散 · 自动 0 帧" tooltip="Dissipate：主动消散退出" class="phase-summary-item phase-summary-dissipate" />
                            <ui:VisualElement name="composition-phase-duration-editor" class="phase-duration-editor" style="display: none;">
                                <ui:Label name="composition-phase-duration-name" text="构建长度" class="phase-duration-label" />
                                <uie:IntegerField name="composition-phase-duration-frames" value="1" class="phase-duration-field" />
                                <ui:Label text="帧" class="phase-duration-unit" />
                                <ui:Button name="composition-phase-duration-auto" text="自动" tooltip="恢复为按当前阶段所有启用 Layer 的最晚结束帧自动计算" class="phase-duration-auto" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="composition-transport">
                            <ui:VisualElement class="transport-group lifecycle-action-group">
                                <ui:Label text="生命周期动作" class="transport-group-title" />
                                <ui:Button name="composition-play-first" text="首次进入" tooltip="Build → Loop" class="transport-action build-action" />
                                <ui:Button name="composition-trigger-rebuild" text="重新激活" tooltip="Rebuild → Loop" class="transport-action rebuild-action" />
                                <ui:Button name="composition-stop-complete" text="自然完成" tooltip="停止 Loop 并播放 Complete" class="transport-action complete-action" />
                                <ui:Button name="composition-stop-dissipate" text="主动消散" tooltip="停止 Loop 并播放 Dissipate" class="transport-action dissipate-action" />
                            </ui:VisualElement>
                            <ui:VisualElement class="transport-divider" />
                            <ui:VisualElement class="transport-group playback-control-group">
                                <ui:Label text="播放" class="transport-group-title" />
                                <ui:Button name="composition-play" text="▶" tooltip="继续播放" class="icon-button" />
                                <ui:Button name="composition-pause" text="Ⅱ" tooltip="暂停在当前帧" class="icon-button" />
                                <ui:Button name="composition-stop" text="■" tooltip="停止并清空预览" class="icon-button playback-active" />
                                <ui:Button name="composition-restart" text="↻" tooltip="当前模式从头重播" class="icon-button" />
                            </ui:VisualElement>
                            <ui:Toggle name="composition-live-refresh" label="实时" value="true" tooltip="关闭后暂停 VFX 仿真、角色动画采样和持续重绘，并保留当前帧" class="transport-toggle" />
                            <ui:Toggle name="composition-loop" label="循环" value="true" class="transport-toggle" />
                            <ui:VisualElement class="transport-spacer" />
                            <ui:VisualElement class="transport-group comparison-control-group">
                                <ui:Toggle name="composition-ab" label="A/B 对比" value="false" />
                                <ui:Button name="composition-set-a" text="记录 A" tooltip="保存当前草稿快照为 A 对比基线" />
                            </ui:VisualElement>
                            <ui:Button name="character-preview-context-toggle" text="角色挂载：关闭" tooltip="打开角色挂载预览配置；角色只用于预览，不进入 Candidate Prefab" class="character-preview-context-toggle" />
                        </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement name="character-preview-context" class="character-preview-context">
                            <ui:VisualElement class="character-preview-target-row">
                                <ui:DropdownField name="character-preview-edit-target" label="编辑目标" class="character-preview-field" />
                                <ui:Label name="character-preview-active-phase" text="当前生效：Build" class="character-preview-phase-badge" />
                                <ui:Label name="character-preview-override-summary" text="继承共享默认" class="character-preview-override-summary" />
                                <ui:Button name="character-preview-reset-phase" text="恢复本阶段默认" tooltip="删除当前阶段的全部角色预览覆盖，重新继承共享默认值" />
                            </ui:VisualElement>
