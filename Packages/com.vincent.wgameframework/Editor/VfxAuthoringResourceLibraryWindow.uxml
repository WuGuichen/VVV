                                <ui:Toggle name="character-preview-socket-axes" label="Socket 坐标轴" value="true" />
                            </ui:VisualElement>
                            <ui:Label name="character-preview-status" text="纯 VFX 模式 · 角色上下文不会进入 Candidate Prefab" class="character-preview-status" />
