                        </ui:Foldout>
                        <ui:Button name="source-prefab-import-rebuild" text="重建 Source Index 并重新分析" class="source-prefab-import-maintenance" />
                        <ui:Button name="source-prefab-import-update-evidence" text="更新素材证据" class="source-prefab-import-maintenance" />
                    </ui:ScrollView>
                </ui:VisualElement>

                <ui:VisualElement class="source-prefab-import-footer">
                    <ui:Label text="默认创建全局素材，不修改 Layer Stack" class="source-prefab-import-footer-note" />
                    <ui:VisualElement class="source-prefab-import-footer-spacer" />
                    <ui:Button name="source-prefab-import-cancel" text="取消  Esc" />
                    <ui:Button name="source-prefab-import-add-layer" text="创建并加入当前阶段" />
                    <ui:Button name="source-prefab-import-add" text="创建全局素材  Enter" class="primary" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="agent-studio-workspace" class="creative-body">
                <ui:ScrollView class="creative-brief-pane creative-panel">
                    <ui:Label text="创作简报" class="panel-title" />
                    <ui:Label text="定义目标与约束；这里不直接写 Unity 资产。" class="panel-subtitle" />
                    <ui:TextField name="brief-name" label="任务名称" class="studio-field" />
                    <ui:TextField name="brief-target-effect" label="目标 Effect ID" class="studio-field" />
                    <ui:TextField name="brief-intent" label="视觉意图" multiline="true" class="studio-field brief-intent" />
                    <ui:DropdownField name="brief-lifecycle" label="生命周期" class="studio-field" />
                    <ui:DropdownField name="style-profile" label="风格配置" class="studio-field" />
                    <ui:DropdownField name="generation-provider" label="素材提供器" class="studio-field" />
                    <ui:DropdownField name="certified-template" label="认证模板" class="studio-field" />
                    <ui:DropdownField name="quality-profile" label="质量档" class="studio-field" />
                    <ui:TextField name="reference-package" label="参考包" class="studio-field" />
                    <ui:VisualElement class="reference-pack-box">
                        <ui:Label text="本机质量参考包" class="contract-title" />
                        <ui:Label name="reference-pack-status" text="尚未连接" class="reference-pack-status" />
                        <ui:Label name="reference-pack-detail" text="授权可复用 · 来源与派生关系受 hash 约束" class="contract-note" />
                        <ui:VisualElement class="reference-pack-actions">
                            <ui:Button name="reference-pack-connect" text="连接授权源库" tooltip="选择本机 Piloto Studio 文件夹；路径只写入 Temp" />
                            <ui:Button name="reference-pack-rescan" text="重新扫描" tooltip="重新生成稳定 manifest；内容变化会使旧任务失效" />
                            <ui:Button name="reference-pack-open" text="打开源目录" />
                            <ui:Button name="reference-pack-browse" text="浏览与提取" tooltip="打开授权源效果结构、A/B 预览和 Primitive 提取工作台" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:Toggle name="explore-primitive" label="允许提出新基础单元" value="true" class="studio-toggle" />
                    <ui:Toggle name="require-fallback" label="必须提供粒子系统降级方案（当前未接入）" value="false" class="studio-toggle" />
                    <ui:VisualElement class="contract-box">
                        <ui:Label text="固定评测合同" class="contract-title" />
                        <ui:Label name="quality-contract" text="等待质量档" class="contract-value" />
                        <ui:Label name="quality-contract-detail" text="固定评测合同由版本化质量档提供" class="contract-note" />
                    </ui:VisualElement>
                    <ui:Label name="creative-provider-status" class="provenance-line" />
                    <ui:Label name="creative-catalog-hash" class="provenance-line" />
                </ui:ScrollView>

                <ui:VisualElement class="creative-candidate-pane creative-panel">
                    <ui:VisualElement class="candidate-toolbar">
                        <ui:VisualElement>
                            <ui:Label text="六方向候选" class="panel-title" />
                            <ui:Label text="首轮 · 同一创作简报、种子与质量档" class="panel-subtitle" />
                        </ui:VisualElement>
                        <ui:VisualElement class="compare-controls">
                            <ui:Button name="compare-play" text="▶" tooltip="动态同步比较尚未接入" class="icon-button" />
                            <ui:Button name="compare-pause" text="Ⅱ" tooltip="动态同步比较尚未接入" class="icon-button" />
                            <ui:Button name="compare-restart" text="↻" tooltip="动态同步比较尚未接入" class="icon-button" />
                            <ui:Toggle name="compare-loop" label="循环" value="false" />
                            <ui:Slider name="compare-speed" label="速度" low-value="0.25" high-value="2" value="1" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:Label name="compare-status" class="compare-status" />
                    <ui:ScrollView class="candidate-scroll">
                        <ui:VisualElement name="candidate-host" class="candidate-grid" />
                    </ui:ScrollView>
                    <ui:ScrollView name="candidate-detail-scroll" mode="Vertical" horizontal-scroller-visibility="Hidden" class="candidate-detail-box">
                        <ui:Label text="当前候选" class="micro-title" />
                        <ui:Label name="candidate-detail" class="candidate-detail" />
                    </ui:ScrollView>
                    <ui:VisualElement class="creative-command-bar">
                        <ui:Button name="creative-generate" text="创建 Agent 任务" tooltip="创建稳定任务包；Development Agent 将通过 Unity MCP 创作真实候选" class="primary" />
                        <ui:Button name="creative-copy-agent" text="复制 Agent 指令" tooltip="复制包含任务文件绝对路径的标准执行指令" />
                        <ui:Button name="creative-refresh-agent" text="刷新 Agent 结果" tooltip="重新读取 progress、receipt 和捕获证据" />
                        <ui:Button name="creative-cancel" text="请求取消" tooltip="写入协作式取消请求，不伪造 Agent 已停止" />
                        <ui:Button name="creative-quality-evidence" text="生成质量证据" tooltip="基于固定 Core 回执运行正式捕获矩阵；没有目标平台性能提供器时报告保持未测量并阻断晋升" />
                        <ui:Button name="creative-clean" text="清理本地会话" tooltip="仅清理受控临时目录" class="danger-quiet" />
                        <ui:Button name="creative-open-plan" text="打开任务目录" />
                    </ui:VisualElement>
                    <ui:Label name="creative-status" class="creative-status" />
                    <ui:Label name="creative-plan-path" class="creative-plan-path" />
                </ui:VisualElement>

                <ui:ScrollView class="creative-review-pane creative-panel">
                    <ui:Label text="复用建议" class="panel-title" />
                    <ui:Label text="优先级：已就绪发布效果 → 配方 → 基础单元 → 基础单元缺口简报" class="panel-subtitle" />
                    <ui:Label name="reuse-gate" class="reuse-gate" />
                    <ui:VisualElement name="reuse-host" class="reuse-host" />

                    <ui:Label text="复用缺口队列" class="panel-title section-gap" />
                    <ui:Label text="尚无已就绪 Effect / Recipe / Primitive 复用入口的角色。" class="panel-subtitle" />
                    <ui:VisualElement name="reuse-gap-host" class="reuse-gap-host" />

                    <ui:Label text="评测解释" class="panel-title section-gap" />
                    <ui:VisualElement class="evaluation-box">
                        <ui:Label text="硬门禁" class="evaluation-title" />
                        <ui:Label name="hard-gate-summary" text="版本化硬门禁由所选质量档提供" class="evaluation-copy" />
                    </ui:VisualElement>
                    <ui:VisualElement class="evaluation-box">
                        <ui:Label text="视觉排序（建议，不是审批）" class="evaluation-title" />
                        <ui:Label text="简报匹配 25 · 可读性 20 · 节奏 20 · 空间运动 15 · 材质色彩 10 · 完成度 10" class="evaluation-copy" />
                    </ui:VisualElement>
                    <ui:VisualElement class="evaluation-box">
                        <ui:Label text="晋升边界" class="evaluation-title" />
                        <ui:Label text="候选始终从草稿开始；自动流程最高只能提出待评审。已就绪状态必须由授权 VFX / 技术美术明确审批。" class="evaluation-copy" />
                    </ui:VisualElement>
                    <ui:Toggle name="creative-human-played" label="已人工运行检查当前候选" value="false" class="studio-toggle" />
                    <ui:Button name="creative-promote" text="晋升所选候选为待评审" tooltip="需要真实播放、显式确认和一次性内存授权；永远不会写为已就绪" class="promote-action" />
                </ui:ScrollView>
            </ui:VisualElement>
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
