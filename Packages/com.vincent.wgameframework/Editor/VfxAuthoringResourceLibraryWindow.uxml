                                <ui:DropdownField name="character-preview-pose" label="快速姿势" class="character-preview-field" />
                                <ui:DropdownField name="character-preview-animation" label="具体动画" class="character-preview-field character-preview-wide" />
                            </ui:VisualElement>
                            <ui:VisualElement class="character-preview-row character-preview-secondary">
