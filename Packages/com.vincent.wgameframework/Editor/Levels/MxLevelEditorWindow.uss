.mx-level-editor {
    background-color: rgb(25, 29, 35);
    color: rgb(226, 230, 235);
}

.mx-level-editor__top-bar {
    flex-direction: row;
    align-items: center;
    min-height: 52px;
    flex-shrink: 0;
    padding-left: 14px;
    padding-right: 14px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.08);
    background-color: rgb(20, 24, 29);
}

.mx-level-editor__header {
    flex-grow: 1;
    min-width: 0;
}

.mx-level-editor__header-row {
    flex-direction: row;
    align-items: center;
    min-width: 0;
}

.mx-level-editor__app-title {
    margin-right: 20px;
    font-size: 15px;
    -unity-font-style: bold;
    color: rgb(244, 246, 248);
    white-space: nowrap;
}

.mx-level-editor__module-popup {
    width: 230px;
    min-width: 170px;
    flex-shrink: 1;
    margin-right: 14px;
}

.mx-level-editor__module-popup > .unity-base-field__label {
    display: none;
}

.mx-level-editor__scene-name {
    min-width: 80px;
    max-width: 220px;
    flex-shrink: 1;
    margin-right: 14px;
    color: rgba(225, 230, 236, 0.76);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.mx-level-editor__state--saved {
    flex-shrink: 0;
    margin-right: 12px;
    color: rgb(92, 190, 104);
    font-size: 11px;
}

.mx-level-editor__state--dirty {
    flex-shrink: 0;
    margin-right: 12px;
    color: rgb(230, 178, 82);
    font-size: 11px;
}

.mx-level-editor__status-summary {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    color: rgba(225, 230, 236, 0.55);
    font-size: 10px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.mx-level-editor__common-toolbar {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.mx-level-editor__common-toolbar > * {
    flex-shrink: 0;
    height: 28px;
    margin-left: 6px;
}

.mx-level-editor__utility-action {
    min-width: 72px;
}

.mx-level-editor__tools-menu {
    min-width: 68px;
    padding-left: 8px;
    padding-right: 8px;
}

.mx-level-editor__secondary-action {
    min-width: 76px;
}

.mx-level-editor__primary-action {
    min-width: 108px;
    background-color: rgb(43, 121, 221);
    border-color: rgb(70, 145, 238);
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
}

.mx-level-editor__content {
    background-color: rgb(25, 29, 35);
}

.mx-level-editor__structured-body {
    padding: 6px;
}

.mx-level-editor__navigation {
    margin-right: 6px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.07);
    border-radius: 4px;
    background-color: rgb(22, 26, 31);
}

.mx-level-editor__navigation-tabs {
    flex-direction: row;
    flex-wrap: nowrap;
    min-height: 38px;
    margin: 8px 8px 2px 8px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.08);
}

.mx-level-editor__navigation-tabs > Button {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    height: 32px;
    margin: 0;
    border-width: 0;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    color: rgba(226, 230, 235, 0.62);
}

.mx-level-editor__navigation-tabs > Button.mx-level-editor__navigation-tab--selected {
    background-color: rgba(43, 121, 221, 0.22);
    border-bottom-width: 2px;
    border-bottom-color: rgb(66, 139, 235);
    color: rgb(240, 244, 248);
}

.mx-level-editor__navigation-list {
    padding-top: 6px;
    padding-left: 6px;
    padding-right: 6px;
    background-color: rgba(0, 0, 0, 0);
}

.mx-level-editor__navigation-row {
    flex-direction: row;
    align-items: center;
    min-height: 34px;
    padding-left: 10px;
    padding-right: 10px;
}

.mx-level-editor__navigation-label {
    flex-grow: 1;
    min-width: 0;
    font-size: 12px;
}

.mx-level-editor__navigation-count {
    min-width: 24px;
    height: 20px;
    padding-left: 6px;
    padding-right: 6px;
    border-radius: 10px;
    background-color: rgba(255, 255, 255, 0.08);
    color: rgba(230, 234, 238, 0.78);
    font-size: 10px;
    -unity-text-align: middle-center;
}

.mx-level-editor__group-list {
    padding-top: 6px;
    padding-left: 6px;
    padding-right: 6px;
    background-color: rgba(0, 0, 0, 0);
}

.mx-level-editor__navigation-footer-action {
    flex-shrink: 0;
    min-height: 30px;
    margin: 8px 12px 12px 12px;
}

.mx-level-editor__row-panel {
    margin-right: 6px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.07);
    border-radius: 4px;
    background-color: rgb(22, 26, 31);
}

.mx-level-editor__main-header {
    padding: 8px 16px 8px 16px;
}

.mx-level-editor__count {
    margin-left: 8px;
    color: rgba(225, 230, 236, 0.6);
    font-size: 11px;
}

.mx-level-editor__range-status {
    margin-bottom: 6px;
    color: rgb(230, 178, 82);
}

.mx-level-editor__search-bar {
    flex-direction: row;
    align-items: center;
    min-width: 0;
}

.mx-level-editor__search-field {
    flex-grow: 1;
    min-width: 220px;
    max-width: 620px;
}

.mx-level-editor__search-clear {
    min-width: 52px;
    margin-left: 6px;
}

.mx-level-editor__module-actions {
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
    flex-shrink: 0;
    min-height: 28px;
    margin-left: 8px;
}

.mx-level-editor__add-menu {
    min-width: 126px;
    height: 26px;
}

.mx-level-editor__placement-mode-action {
    flex-shrink: 0;
    min-width: 112px;
    height: 26px;
    margin-left: 8px;
    border-color: rgb(70, 145, 238);
    color: rgb(114, 174, 244);
    background-color: rgba(43, 121, 221, 0.08);
}

Button.mx-level-editor__placement-mode-action {
    border-color: rgb(70, 145, 238);
    color: rgb(114, 174, 244);
    background-color: rgba(43, 121, 221, 0.08);
}

.mx-level-editor__placement-mode-action--open,
.mx-level-editor__placement-mode-action--active {
    border-color: rgb(80, 157, 247);
    color: rgb(245, 248, 252);
    background-color: rgba(43, 121, 221, 0.32);
}

.mx-level-editor__placement-mode-action--active {
    -unity-font-style: bold;
}

.mx-level-editor__placement-popover {
    position: absolute;
    width: 360px;
    padding: 12px;
    border-width: 1px;
    border-color: rgba(107, 160, 226, 0.48);
    border-radius: 5px;
    background-color: rgb(34, 39, 47);
}

.mx-level-editor__placement-fields {
    flex-direction: column;
}

.mx-level-editor__placement-field {
    flex-grow: 1;
    min-width: 0;
    margin-bottom: 8px;
}

.mx-level-editor__placement-field > .unity-base-field__label {
    min-width: 70px;
    max-width: 70px;
}

.mx-level-editor__placement-footer {
    flex-direction: row;
    align-items: center;
    min-height: 30px;
    margin-top: 2px;
    padding-top: 8px;
    border-top-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.08);
}

.mx-level-editor__placement-options {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
}

.mx-level-editor__placement-actions {
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
}

.mx-level-editor__placement-icon-toggle {
    width: 28px;
    min-width: 28px;
    height: 28px;
    margin-right: 6px;
    -unity-text-align: middle-center;
    -unity-background-scale-mode: scale-to-fit;
    background-color: rgba(255, 255, 255, 0.035);
    border-color: rgba(255, 255, 255, 0.12);
    color: rgba(225, 232, 240, 0.78);
}

.mx-level-editor__placement-icon-toggle:checked {
    background-color: rgba(43, 121, 221, 0.34);
    border-color: rgb(70, 145, 238);
    color: rgb(245, 248, 252);
}

.mx-level-editor__placement-action {
    min-width: 104px;
    height: 28px;
    margin: 0;
    background-color: rgb(43, 121, 221);
    border-color: rgb(70, 145, 238);
    color: rgb(255, 255, 255);
}

.mx-level-editor__table-header {
    min-height: 30px;
    max-height: 30px;
    margin-left: 8px;
    margin-right: 8px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.1);
    color: rgba(225, 230, 236, 0.62);
    font-size: 10px;
}

.mx-level-editor__row-list {
    margin-left: 8px;
    margin-right: 8px;
    margin-bottom: 8px;
    background-color: rgba(0, 0, 0, 0);
}

.mx-level-editor__table-row {
    min-height: 30px;
    max-height: 32px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.045);
    font-size: 11px;
}

.mx-level-editor__inspector {
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.07);
    border-radius: 4px;
    background-color: rgb(22, 26, 31);
    padding: 12px;
}

.mx-level-editor__inspector-header {
    flex-direction: row;
    align-items: center;
    min-height: 32px;
    padding-bottom: 6px;
    margin-bottom: 4px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.08);
}

.mx-level-editor__inspector-tabs {
    flex-direction: row;
    flex-wrap: nowrap;
    min-height: 32px;
    margin-bottom: 8px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.08);
}

.mx-level-editor__inspector-tabs > Button {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    height: 28px;
    margin: 0;
    border-width: 0;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    color: rgba(226, 230, 235, 0.62);
}

.mx-level-editor__inspector-tabs > Button.mx-level-editor__inspector-tab--selected {
    background-color: rgba(43, 121, 221, 0.2);
    border-bottom-width: 2px;
    border-bottom-color: rgb(66, 139, 235);
    color: rgb(240, 244, 248);
}

.mx-level-editor__inspector .unity-base-field {
    min-width: 0;
}

.mx-level-editor__empty-inspector {
    padding-bottom: 12px;
    margin-bottom: 10px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.08);
}

.mx-level-editor__inspector-title {
    flex-grow: 1;
    min-width: 0;
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(245, 247, 249);
}

.mx-level-editor__inspector-status--valid {
    color: rgb(92, 190, 104);
    font-size: 11px;
}

.mx-level-editor__inspector-status--disabled {
    color: rgba(225, 230, 236, 0.5);
    font-size: 11px;
}

.mx-level-editor__inspector-section {
    padding-top: 4px;
    padding-bottom: 6px;
}

.mx-level-editor__inspector-section-title {
    margin-bottom: 8px;
    font-size: 12px;
    -unity-font-style: bold;
    color: rgba(235, 239, 243, 0.86);
}

.mx-level-editor__inspector-actions {
    flex-direction: row;
}

.mx-level-editor__inspector-actions > Button {
    flex-grow: 1;
    margin-right: 5px;
}

.mx-level-editor__advanced-settings {
    margin-top: 12px;
    padding-top: 10px;
    border-top-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.08);
}

.mx-level-editor__danger-action {
    margin-top: 10px;
    color: rgb(229, 104, 104);
}

.mx-level-editor__region-object-settings {
    margin-top: 2px;
    margin-bottom: 2px;
}

.mx-level-editor__region-object-settings > .unity-base-field > .unity-base-field__label {
    min-width: 82px;
    max-width: 82px;
}

.mx-level-editor__region-actions {
    margin-top: 7px;
    margin-bottom: 2px;
}

.mx-level-editor__region-more-action {
    flex-shrink: 0;
    min-width: 58px;
    height: 22px;
}

.mx-level-editor__trigger-count-badge {
    min-width: 30px;
    height: 18px;
    margin-left: 7px;
    padding-left: 7px;
    padding-right: 7px;
    border-radius: 9px;
    background-color: rgba(255, 255, 255, 0.075);
    color: rgba(226, 232, 238, 0.7);
    font-size: 9px;
    -unity-text-align: middle-center;
}

.mx-level-editor__trigger-group {
    margin-top: 7px;
    padding-top: 7px;
    border-top-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.065);
}

.mx-level-editor__trigger-group-title {
    margin-bottom: 3px;
    color: rgba(125, 182, 247, 0.9);
    font-size: 10px;
    -unity-font-style: bold;
}

.mx-level-editor__trigger-field-row {
    flex-direction: row;
    align-items: center;
    min-height: 28px;
    min-width: 0;
    margin-top: 2px;
}

.mx-level-editor__trigger-field-label {
    flex-shrink: 0;
    width: 82px;
    margin-right: 7px;
    color: rgba(225, 230, 236, 0.62);
    font-size: 10px;
}

.mx-level-editor__trigger-field-editor {
    flex-grow: 1;
    min-width: 0;
}

.mx-level-editor__trigger-input {
    flex-grow: 1;
    min-width: 0;
    margin: 0;
}

.mx-level-editor__trigger-readonly {
    min-height: 20px;
    padding-left: 7px;
    padding-right: 7px;
    border-radius: 2px;
    background-color: rgba(255, 255, 255, 0.028);
    color: rgba(232, 236, 241, 0.8);
    font-size: 10px;
    -unity-text-align: middle-left;
    white-space: normal;
}

.mx-level-editor__trigger-target-primary {
    margin-top: 0;
    margin-bottom: 0;
}

.mx-level-editor__trigger-target-primary-value {
    color: rgba(232, 236, 241, 0.9);
    font-size: 11px;
}

.mx-level-editor__trigger-target-requirements {
    margin-top: 1px;
    color: rgba(225, 230, 236, 0.62);
    font-size: 10px;
    white-space: normal;
}

.mx-level-editor__trigger-timing {
    flex-direction: row;
    align-items: center;
}

.mx-level-editor__trigger-chip {
    min-width: 34px;
    height: 20px;
    margin-right: 5px;
    padding-left: 8px;
    padding-right: 8px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    border-radius: 10px;
    background-color: rgba(255, 255, 255, 0.025);
    color: rgba(225, 230, 236, 0.38);
    font-size: 9px;
    -unity-text-align: middle-center;
}

.mx-level-editor__trigger-chip--selected {
    border-color: rgba(70, 145, 238, 0.5);
    background-color: rgba(43, 121, 221, 0.16);
    color: rgb(132, 185, 246);
}

.mx-level-editor__trigger-field-content {
    flex-grow: 1;
    min-width: 0;
}

.mx-level-editor__trigger-info-strip {
    margin-top: 4px;
    padding: 5px 7px 5px 7px;
    border-radius: 2px;
    background-color: rgba(77, 143, 87, 0.1);
    color: rgba(159, 211, 168, 0.8);
    font-size: 9px;
    white-space: normal;
}

.mx-level-editor__trigger-source-editor {
    min-width: 0;
}

.mx-level-editor__trigger-buff-summary {
    margin-top: 4px;
    color: rgba(232, 238, 244, 0.9);
    font-size: 10px;
    opacity: 1;
    white-space: normal;
}

.mx-level-editor__trigger-source-summary {
    margin-top: 3px;
    color: rgba(217, 225, 233, 0.62);
    font-size: 9px;
    opacity: 1;
    white-space: normal;
}

.mx-level-editor__trigger-foldout {
    margin-top: 7px;
    padding-top: 5px;
    border-top-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.06);
    color: rgba(225, 230, 236, 0.64);
    font-size: 10px;
}

.mx-level-editor__trigger-link-card {
    flex-direction: row;
    align-items: center;
    min-height: 34px;
    margin-top: 8px;
    padding-top: 5px;
    padding-bottom: 5px;
    border-top-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.08);
}

.mx-level-editor__trigger-link-summary {
    flex-grow: 1;
    min-width: 0;
    color: rgba(225, 232, 239, 0.72);
    font-size: 11px;
}

.mx-level-editor__trigger-link-open,
.mx-level-editor__trigger-link-add {
    flex-shrink: 0;
    height: 23px;
    margin-left: 5px;
}

.mx-level-editor__trigger-link-open {
    min-width: 108px;
    border-color: rgba(70, 145, 238, 0.58);
    background-color: rgba(43, 121, 221, 0.11);
    color: rgb(125, 182, 247);
}

.mx-level-editor__trigger-link-add {
    min-width: 112px;
}

.mx-level-editor__trigger-workspace,
.mx-level-editor__trigger-workspace-split {
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
}

.mx-level-editor__trigger-workspace-navigation-toggle {
    align-self: flex-start;
    min-width: 124px;
    height: 25px;
    margin: 7px 8px 0 8px;
    border-color: rgba(70, 145, 238, 0.48);
    background-color: rgba(43, 121, 221, 0.08);
    color: rgb(125, 182, 247);
}

.mx-level-editor__trigger-workspace--narrow .mx-level-editor__trigger-workspace-editor {
    padding-left: 14px;
    padding-right: 14px;
}

.mx-level-editor__trigger-workspace-navigation {
    min-width: 240px;
    max-width: 360px;
    min-height: 0;
    padding: 8px;
    border-right-width: 1px;
    border-right-color: rgba(255, 255, 255, 0.08);
    background-color: rgb(21, 26, 32);
}

.mx-level-editor__trigger-workspace-nav-actions {
    flex-direction: row;
    align-items: center;
    min-height: 28px;
    margin-bottom: 7px;
}

.mx-level-editor__trigger-workspace-search {
    flex-grow: 1;
    min-width: 90px;
    margin: 0 5px 0 0;
}

.mx-level-editor__trigger-workspace-add {
    flex-shrink: 0;
    min-width: 88px;
    height: 24px;
    margin: 0;
    border-color: rgba(70, 145, 238, 0.7);
    background-color: rgba(43, 121, 221, 0.14);
    color: rgb(125, 182, 247);
}

.mx-level-editor__trigger-workspace-categories {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 5px;
}

.mx-level-editor__trigger-workspace-category {
    height: 22px;
    margin: 0 4px 3px 0;
    padding-left: 7px;
    padding-right: 7px;
    border-color: rgba(255, 255, 255, 0.06);
    background-color: rgba(255, 255, 255, 0.025);
    color: rgba(225, 232, 239, 0.58);
    font-size: 9px;
}

.mx-level-editor__trigger-workspace-category--selected {
    border-color: rgba(70, 145, 238, 0.58);
    background-color: rgba(43, 121, 221, 0.16);
    color: rgb(132, 185, 246);
}

.mx-level-editor__trigger-workspace-filter {
    flex-direction: row;
    align-items: center;
    min-height: 24px;
    margin-bottom: 5px;
    padding-left: 7px;
    border-radius: 3px;
    background-color: rgba(43, 121, 221, 0.09);
    color: rgba(190, 216, 246, 0.78);
    font-size: 9px;
}

.mx-level-editor__trigger-workspace-filter > Label {
    flex-grow: 1;
    min-width: 0;
}

.mx-level-editor__trigger-workspace-filter > Button {
    flex-shrink: 0;
    width: 24px;
    height: 20px;
    margin: 0 2px 0 3px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

.mx-level-editor__trigger-workspace-list {
    flex-grow: 1;
    min-height: 0;
}

.mx-level-editor__trigger-workspace-item {
    min-height: 47px;
    margin-bottom: 3px;
    padding: 6px 7px 5px 7px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.045);
    border-radius: 3px;
    background-color: rgba(255, 255, 255, 0.018);
}

.mx-level-editor__trigger-workspace-item:hover {
    border-color: rgba(255, 255, 255, 0.11);
    background-color: rgba(255, 255, 255, 0.045);
}

.mx-level-editor__trigger-workspace-item--selected {
    border-color: rgba(70, 145, 238, 0.58);
    background-color: rgba(43, 121, 221, 0.14);
}

.mx-level-editor__trigger-workspace-item-first-line {
    flex-direction: row;
    align-items: center;
    min-width: 0;
}

.mx-level-editor__trigger-workspace-item-title {
    flex-grow: 1;
    min-width: 0;
    color: rgba(239, 243, 247, 0.92);
    font-size: 11px;
    -unity-font-style: bold;
    -unity-text-overflow-position: end;
    overflow: hidden;
    white-space: nowrap;
}

.mx-level-editor__trigger-workspace-item-detail {
    margin-top: 3px;
    margin-left: 15px;
    color: rgba(218, 226, 234, 0.48);
    font-size: 9px;
    -unity-text-overflow-position: end;
    overflow: hidden;
    white-space: nowrap;
}

.mx-level-editor__trigger-workspace-item-status--valid,
.mx-level-editor__trigger-workspace-item-status--disabled,
.mx-level-editor__trigger-workspace-item-status--error {
    flex-shrink: 0;
    width: 12px;
    margin-right: 3px;
    font-size: 9px;
}

.mx-level-editor__trigger-workspace-item-status--valid {
    color: rgb(92, 190, 104);
}

.mx-level-editor__trigger-workspace-item-status--disabled {
    color: rgba(225, 230, 236, 0.35);
}

.mx-level-editor__trigger-workspace-item-status--error {
    color: rgb(230, 166, 75);
}

.mx-level-editor__trigger-workspace-empty {
    min-height: 60px;
    padding-top: 18px;
    color: rgba(225, 230, 236, 0.45);
    font-size: 10px;
    -unity-text-align: upper-center;
    white-space: normal;
}

.mx-level-editor__trigger-workspace-editor-host {
    min-width: 0;
    min-height: 0;
    background-color: rgb(24, 29, 35);
}

.mx-level-editor__trigger-workspace-editor {
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
    padding: 16px 22px 24px 22px;
}

.mx-level-editor__trigger-workspace-editor #unity-content-container {
    max-width: 1180px;
}

.mx-level-editor__trigger-workspace-editor-empty {
    flex-grow: 1;
    padding-top: 90px;
    color: rgba(225, 230, 236, 0.45);
    font-size: 11px;
    -unity-text-align: upper-center;
    white-space: normal;
}

.mx-level-editor__trigger-workspace-header {
    margin-bottom: 6px;
    padding-bottom: 12px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.085);
}

.mx-level-editor__trigger-workspace-header-line {
    flex-direction: row;
    align-items: center;
    min-width: 0;
    min-height: 30px;
}

.mx-level-editor__trigger-workspace-locate {
    flex-shrink: 0;
    width: 27px;
    height: 25px;
    margin: 0 6px 0 0;
    padding: 0;
    border-color: rgba(70, 145, 238, 0.45);
    background-color: rgba(43, 121, 221, 0.08);
    color: rgb(125, 182, 247);
    font-size: 14px;
}

.mx-level-editor__trigger-workspace-name {
    flex-grow: 1;
    min-width: 160px;
    margin: 0 7px 0 0;
    font-size: 15px;
    -unity-font-style: bold;
}

.mx-level-editor__trigger-workspace-enabled {
    flex-shrink: 0;
    min-width: 58px;
    margin: 0 5px 0 0;
}

.mx-level-editor__trigger-workspace-secondary,
.mx-level-editor__trigger-workspace-more {
    flex-shrink: 0;
    min-width: 48px;
    height: 24px;
    margin: 0 0 0 4px;
}

.mx-level-editor__trigger-workspace-metadata {
    margin-top: 5px;
    margin-left: 33px;
    color: rgba(218, 226, 234, 0.45);
    font-size: 9px;
    white-space: normal;
}

.mx-level-editor__trigger-workspace-editor .mx-level-editor__trigger-group {
    margin-top: 9px;
    padding: 10px 3px 11px 3px;
    border-top-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.085);
}

.mx-level-editor__trigger-workspace-editor .mx-level-editor__trigger-group-title {
    margin-bottom: 8px;
    color: rgb(125, 182, 247);
    font-size: 12px;
}

.mx-level-editor__trigger-workspace-editor .mx-level-editor__trigger-field-label {
    width: 104px;
}

.mx-level-editor__trigger-clause-row {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    min-height: 31px;
    margin-top: 2px;
    margin-bottom: 2px;
}

.mx-level-editor__trigger-clause-word {
    flex-shrink: 0;
    margin-right: 7px;
    color: rgba(220, 226, 232, 0.68);
    font-size: 11px;
}

.mx-level-editor__trigger-clause-value {
    flex-shrink: 0;
    margin-right: 8px;
    color: rgba(238, 242, 247, 0.94);
    font-size: 11px;
    -unity-font-style: bold;
}

.mx-level-editor__trigger-clause-scope {
    flex-shrink: 0;
    min-width: 56px;
    margin-right: 8px;
    padding: 3px 8px 3px 8px;
    border-width: 1px;
    border-color: rgba(70, 145, 238, 0.35);
    border-radius: 3px;
    background-color: rgba(43, 121, 221, 0.09);
    color: rgb(125, 182, 247);
    font-size: 10px;
    -unity-text-align: middle-center;
}

.mx-level-editor__trigger-clause-control {
    flex-grow: 0;
    flex-shrink: 1;
    min-width: 140px;
    min-height: 24px;
    margin: 1px 8px 1px 0;
}

.mx-level-editor__trigger-clause-control--medium {
    width: 190px;
}

.mx-level-editor__trigger-clause-control--wide {
    width: 265px;
}

.mx-level-editor__trigger-clause-control .unity-base-field,
.mx-level-editor__trigger-clause-control .unity-base-field__input {
    min-width: 0;
}

.mx-level-editor__trigger-clause-number {
    flex-grow: 0;
    flex-shrink: 0;
    width: 66px;
    margin-right: 7px;
}

.mx-level-editor__trigger-clause-summary {
    margin: 2px 0 3px 72px;
    color: rgba(214, 223, 232, 0.58);
    font-size: 10px;
    white-space: normal;
}

.mx-level-editor__trigger-condition-builder {
    margin-top: 8px;
    padding-top: 7px;
    border-top-width: 1px;
    border-top-color: rgba(124, 143, 162, 0.16);
}

.mx-level-editor__trigger-condition-heading {
    min-height: 25px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 4px;
}

.mx-level-editor__trigger-condition-title {
    color: rgba(220, 230, 239, 0.72);
    font-size: 11px;
    -unity-font-style: bold;
}

.mx-level-editor__trigger-condition-logic {
    width: 142px;
    flex-shrink: 0;
}

.mx-level-editor__trigger-condition-clause {
    min-height: 28px;
    flex-direction: row;
    align-items: center;
    margin-bottom: 3px;
    padding: 2px 4px;
    background-color: rgba(72, 91, 108, 0.12);
    border-left-width: 2px;
    border-left-color: rgba(65, 145, 229, 0.46);
}

.mx-level-editor__trigger-condition-negate {
    width: 34px;
    min-width: 34px;
    margin-right: 5px;
    border-width: 1px;
    border-color: rgba(124, 143, 162, 0.26);
    background-color: rgba(72, 91, 108, 0.18);
    color: rgba(201, 211, 221, 0.58);
    -unity-text-align: middle-center;
}

.mx-level-editor__trigger-condition-negate:checked {
    border-color: rgba(70, 145, 238, 0.82);
    background-color: rgba(43, 121, 221, 0.28);
    color: rgb(146, 199, 255);
}

.mx-level-editor__trigger-condition-operand {
    width: 190px;
    min-width: 140px;
    flex-shrink: 1;
    margin-right: 5px;
}

.mx-level-editor__trigger-condition-comparison {
    width: 58px;
    min-width: 54px;
    flex-shrink: 0;
    margin-right: 5px;
}

.mx-level-editor__trigger-condition-value {
    width: 88px;
    min-width: 70px;
    flex-shrink: 0;
    margin-right: 5px;
}

.mx-level-editor__trigger-condition-remove {
    width: 26px;
    min-width: 26px;
    margin-left: auto;
    color: rgba(225, 167, 167, 0.82);
}

.mx-level-editor__trigger-condition-empty {
    margin: 1px 0 5px 0;
    color: rgba(201, 211, 221, 0.48);
    font-size: 10px;
}

.mx-level-editor__trigger-condition-add {
    width: 112px;
    margin-top: 3px;
    color: rgb(105, 177, 243);
}

.mx-level-editor__trigger-workspace-effect {
    flex-direction: row;
    align-items: flex-start;
    min-height: 44px;
    margin-top: 12px;
    padding: 10px 10px 9px 12px;
    border-left-width: 3px;
    border-left-color: rgba(70, 145, 238, 0.82);
    border-radius: 3px;
    background-color: rgba(43, 121, 221, 0.1);
}

.mx-level-editor__trigger-workspace-effect-text {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    color: rgba(228, 237, 248, 0.9);
    font-size: 11px;
    white-space: normal;
}

.mx-level-editor__trigger-workspace-effect-copy {
    flex-shrink: 0;
    width: 44px;
    height: 22px;
    margin: 0 0 0 8px;
}

.mx-level-editor__trigger-workspace-runtime {
    margin-top: 12px;
    padding-top: 10px;
    border-top-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.08);
}

.mx-level-editor__diagnostics {
    min-height: 38px;
    margin: 0 6px 6px 6px;
    padding-left: 12px;
    padding-right: 12px;
    border-width: 1px;
    border-color: rgba(89, 178, 101, 0.18);
    border-radius: 4px;
    background-color: rgba(65, 135, 75, 0.08);
    color: rgb(105, 202, 117);
}

.mx-level-editor__diagnostics--issues {
    border-color: rgba(220, 164, 72, 0.28);
    background-color: rgba(172, 113, 32, 0.1);
    color: rgb(230, 178, 82);
}
