.character-preview-context-toggle.drawer-open { color: #d9effb; border-color: #5487a2; background-color: #213a49; }
.character-preview-context-toggle.character-attached { color: #bfe99f; border-color: #47743b; background-color: #1d321d; }
.character-preview-context {
    display: none;
