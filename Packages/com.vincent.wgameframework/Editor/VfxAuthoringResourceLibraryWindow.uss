.inspector-brief { min-height: 72px; }
.layer-identity-row { flex-direction: column; }
.layer-identity-row > .studio-field { width: 100%; flex-grow: 0; min-width: 0; }
.inspector-foldout { margin-top: 6px; padding: 3px 4px 5px 4px; border-width: 1px; border-color: #30404a; border-radius: 4px; background-color: #151e24; }
.draft-id-copy-button { min-height: 24px; margin-top: 4px; align-self: flex-end; }
.phase-summary-hint { margin-top: 5px; color: #68808e; font-size: 8px; white-space: normal; }
.manual-inspector .studio-field { min-width: 0; flex-shrink: 1; margin-top: 5px; }
.manual-inspector .studio-field > .unity-base-field__label {
    width: 112px;
    min-width: 112px;
    flex-basis: 112px;
}
.manual-inspector .studio-field > .unity-base-field__input { min-width: 0; flex-grow: 1; }
.manual-diagnostics { flex-shrink: 0; min-height: 44px; margin: 0 7px 7px 7px; }
.manual-compact .manual-palette { width: 300px; min-width: 260px; }
.manual-compact .manual-preview-pane { min-width: 360px; }
.manual-compact .manual-inspector { width: 340px; min-width: 300px; }
.manual-compact .toolbar-field { width: 94px; }
.manual-compact .speed-field { display: none; }
.manual-compact .composition-toolbar { min-height: 90px; height: auto; flex-wrap: wrap; align-content: center; }
.manual-compact .preview-heading { min-width: 128px; }
.manual-compact .preview-toolbar-spacer { display: none; }
.manual-compact .preview-environment-group { flex-grow: 1; margin-left: 8px; }
.manual-compact .preview-spatial-inline { flex-grow: 1; margin-top: 4px; margin-left: 0; }
.manual-compact .root-position-inline { flex-grow: 1; width: 220px; }
.manual-compact .composition-control-row { min-height: 88px; height: auto; flex-wrap: wrap; }
.manual-compact .phase-summary-strip { width: 100%; min-width: 0; min-height: 43px; height: 43px; border-right-width: 0; border-bottom-width: 1px; border-bottom-color: #34434c; }
.manual-compact .phase-summary-title { width: 52px; }
.manual-compact .phase-summary-item { flex-grow: 1; min-width: 72px; }
.manual-compact .phase-duration-editor { min-width: 210px; }
.manual-compact .composition-transport { width: 100%; min-height: 43px; height: 43px; flex-wrap: nowrap; }
.manual-compact .transport-toggle,
.manual-compact .character-preview-context-toggle { margin-top: 3px; margin-bottom: 3px; }
.manual-compact .composition-transport .transport-spacer { display: none; }
.manual-compact .manual-draft-toolbar { min-height: 46px; height: auto; flex-wrap: wrap; align-content: center; }
.manual-compact .manual-draft-current { width: 285px; flex-grow: 1; }
.manual-compact .composition-save-status { max-width: 130px; }
.manual-compact .draft-browser-panel { left: 12px; top: 104px; width: 540px; }
.manual-compact .element-filter-grid { min-height: 116px; height: 116px; max-height: 116px; flex-grow: 0; }
.manual-compact .element-filter-row { min-height: 38px; height: 38px; max-height: 38px; flex-grow: 0; flex-shrink: 0; flex-wrap: nowrap; align-content: flex-start; }
.manual-compact .compact-filter { width: 32%; min-height: 36px; height: 36px; flex-grow: 1; flex-shrink: 1; flex-direction: column; margin-right: 2px; margin-bottom: 1px; }
.manual-compact .compact-filter .unity-base-field__label { width: 100%; min-width: 0; height: 14px; margin: 0; font-size: 8px; }
.manual-compact .compact-filter .unity-base-field__input { width: 100%; min-width: 0; height: 20px; }
.manual-compact .element-taxonomy-foldout > .unity-foldout__content { min-height: 116px; height: 116px; max-height: 116px; flex-grow: 0; }
.manual-compact .element-list { min-height: 150px; }
.manual-compact .semantic-field-row { flex-wrap: wrap; }
.manual-compact .semantic-third { width: 48%; flex-grow: 0; margin-bottom: 3px; }
.manual-compact .element-quick-preview { left: 274px; width: 410px; }
.manual-compact .character-preview-wide { width: 175px; }
.manual-compact .character-preview-speed { width: 145px; }
.manual-compact .character-preview-row { flex-grow: 0; flex-shrink: 0; align-content: flex-start; }
.manual-compact .character-preview-primary { min-height: 32px; height: 32px; max-height: 32px; flex-wrap: nowrap; }
.manual-compact .character-preview-secondary { min-height: 62px; height: 62px; max-height: 62px; flex-wrap: wrap; }
.manual-compact .character-preview-field,
.manual-compact .character-preview-speed,
.manual-compact .character-preview-row > Button,
.manual-compact .character-preview-row > Toggle { margin-top: 2px; margin-bottom: 3px; }
.manual-compact .composition-preview-host { min-height: 120px; }
.manual-compact .composition-layer-region { height: 210px; min-height: 90px; }
.manual-compact .layer-list-host,
.manual-compact .composition-layer-list { min-height: 70px; }
.manual-compact .layer-col-preview,
.manual-compact .layer-thumb,
.manual-compact .layer-col-range,
.manual-compact .layer-range { display: none; }
.manual-compact .layer-col-name { width: 110px; }
.manual-compact .layer-name-block { width: 110px; }
.manual-compact .layer-col-role { width: 54px; }
.manual-compact .layer-role { width: 49px; }
.manual-workspace.preview-maximized .manual-draft-toolbar,
.manual-workspace.preview-maximized .manual-palette,
.manual-workspace.preview-maximized .manual-inspector,
.manual-workspace.preview-maximized .composition-layer-splitter,
.manual-workspace.preview-maximized .composition-layer-region { display: none; }
.manual-workspace.preview-maximized .manual-body { padding: 0; }
.manual-workspace.preview-maximized .manual-preview-pane { margin: 0; border-width: 0; }
.manual-workspace.preview-maximized .composition-preview-host { min-height: 420px; }

.creative-header {
    height: 61px;
    min-height: 61px;
    flex-shrink: 0;
    padding: 9px 14px;
    flex-direction: row;
    align-items: center;
    background-color: #192128;
    border-bottom-width: 1px;
    border-bottom-color: #35414a;
}

.creative-title-block { min-width: 270px; }
.creative-title { font-size: 17px; -unity-font-style: bold; color: #eef3f7; }
.creative-subtitle { margin-top: 2px; font-size: 10px; color: #7e8b96; }

.lifecycle-rail {
    flex-grow: 1;
    flex-direction: row;
    justify-content: center;
    align-items: center;
}

.stage-index {
    width: 23px;
    height: 23px;
    border-radius: 12px;
    background-color: #245f89;
    color: #dff2ff;
    -unity-text-align: middle-center;
    font-size: 9px;
}

.stage-name { margin-left: 5px; margin-right: 9px; -unity-font-style: bold; color: #cfd9e1; }
.stage-arrow { margin-right: 9px; color: #51616e; }
.secondary-action { min-width: 154px; }

.creative-body {
    flex-grow: 1;
    min-height: 0;
    flex-direction: row;
    padding: 8px;
}

.creative-panel {
    min-height: 0;
    background-color: #1a2229;
    border-width: 1px;
    border-color: #34414b;
    border-radius: 6px;
}

.creative-brief-pane {
    width: 292px;
    min-width: 250px;
    margin-right: 8px;
    padding: 12px;
}

.creative-candidate-pane {
    flex-grow: 1;
    min-width: 420px;
    margin-right: 8px;
    padding: 10px;
}

.creative-review-pane {
    width: 322px;
    min-width: 280px;
    padding: 12px;
}

.panel-title { font-size: 14px; -unity-font-style: bold; color: #e1e8ee; }
.panel-subtitle { margin-top: 2px; margin-bottom: 10px; font-size: 9px; color: #74838f; white-space: normal; }

.studio-field { margin-top: 5px; margin-bottom: 5px; }
.studio-field > .unity-base-field__label { width: 78px; color: #8c99a4; }
.brief-intent { min-height: 104px; }
.brief-intent .unity-text-field__input { white-space: normal; }
.studio-toggle { margin-top: 7px; color: #aeb8c1; }

.contract-box {
    margin-top: 13px;
    padding: 9px;
    background-color: #151b20;
    border-left-width: 3px;
    border-left-color: #3d91c9;
    border-radius: 3px;
}

.contract-title { font-size: 10px; -unity-font-style: bold; color: #b8c7d1; }
.contract-value { margin-top: 4px; color: #78bfe8; }
.contract-note { margin-top: 3px; color: #75828c; white-space: normal; font-size: 9px; }
.provenance-line { margin-top: 8px; color: #7e8c97; white-space: normal; font-size: 9px; }
.status-warning { color: #e1a24e; }

.candidate-toolbar {
    min-height: 42px;
    flex-shrink: 0;
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
}

.compare-controls {
    flex-direction: row;
    align-items: center;
}

.compare-controls Toggle { width: 66px; }
.compare-controls Slider { width: 130px; }
.compare-status { min-height: 24px; padding: 5px 7px; color: #7e909d; background-color: #141b20; border-radius: 3px; font-size: 9px; }
.candidate-scroll { flex-grow: 1; min-height: 250px; margin-top: 7px; }

.candidate-grid {
    flex-grow: 1;
    flex-direction: row;
    flex-wrap: wrap;
    align-content: flex-start;
}

.candidate-card {
    width: 31.6%;
    min-width: 150px;
    min-height: 178px;
    margin: 4px;
    padding: 10px;
    align-items: stretch;
    -unity-text-align: upper-left;
    background-color: #202931;
    border-color: #3b4954;
}
.candidate-preview {
    height: 84px;
    margin-top: 6px;
    background-color: #0b1014;
    -unity-background-scale-mode: scale-and-crop;
    border-width: 1px;
    border-color: #2e3a43;
    border-radius: 3px;
    justify-content: flex-end;
}
.candidate-preview-state {
    padding: 3px 5px;
    color: #82919c;
    background-color: rgba(8, 12, 15, 0.84);
    font-size: 8px;
    white-space: normal;
}
.candidate-preview.has-capture { border-color: #486779; }
.candidate-preview.capture-error { border-color: #8b4d4d; }
.candidate-preview.capture-error .candidate-preview-state { color: #d38a8a; }

.candidate-card:hover {
    background-color: #27343d;
    border-color: #6b899d;
    translate: 0 -1px;
}

.candidate-card.selected {
    background-color: #27343d;
    border-width: 2px;
    border-color: #4fa7df;
}

.candidate-card.candidate-generated { border-color: #4e8352; }
.candidate-card.candidate-failed { border-color: #9b5454; }
.candidate-index { color: #6faed3; font-size: 9px; }
.candidate-title { margin-top: 5px; -unity-font-style: bold; color: #ecf2f6; font-size: 13px; }
.candidate-summary { flex-grow: 1; margin-top: 6px; color: #929faa; white-space: normal; font-size: 9px; }
.candidate-status { margin-top: 7px; color: #c4a66b; font-size: 9px; }
.candidate-score { margin-top: 3px; color: #71818d; white-space: normal; font-size: 8px; }

.candidate-detail-box {
    min-height: 74px;
    flex-shrink: 0;
    margin-top: 6px;
    padding: 8px;
    background-color: #151c21;
    border-radius: 4px;
}

.candidate-detail { color: #aab6bf; white-space: normal; font-size: 9px; }

.creative-command-bar {
    height: 39px;
    min-height: 39px;
    flex-shrink: 0;
    flex-direction: row;
    padding-top: 6px;
}

.creative-command-bar Button { flex-grow: 1; margin-right: 5px; }
.creative-status { min-height: 24px; margin-top: 4px; padding: 5px 7px; background-color: #151c21; border-radius: 3px; white-space: normal; font-size: 9px; }
.creative-plan-path { margin-top: 4px; color: #72818c; white-space: normal; font-size: 8px; }

.reuse-gate {
    margin-bottom: 7px;
    padding: 7px;
    background-color: #151c21;
    border-radius: 3px;
    white-space: normal;
    font-size: 9px;
}

.reuse-host { min-height: 80px; }
.reference-pack-box {
    margin-top: 8px;
    padding: 9px;
    background-color: #172128;
    border-width: 1px;
    border-color: #334650;
    border-radius: 4px;
}
.reference-pack-status { margin-top: 4px; color: #d5a84f; -unity-font-style: bold; }
.reference-pack-status.connected { color: #78c857; }
.reference-pack-actions { flex-direction: row; margin-top: 7px; }
.reference-pack-actions > Button { flex-grow: 1; margin-right: 4px; min-height: 24px; }
.reuse-gap-host { min-height: 48px; }
.reuse-gap-row {
    margin-top: 5px;
    padding: 7px 8px;
    background-color: #1d252b;
    border-width: 1px;
    border-color: #34424c;
    border-radius: 3px;
    -unity-text-align: middle-left;
}
.reuse-gap-row:hover { background-color: #283640; border-color: #a47735; }
.reuse-gap-title { -unity-font-style: bold; color: #d0b47a; font-size: 10px; }
.reuse-gap-detail { margin-top: 3px; color: #82919c; font-size: 8px; }

.reuse-row {
    min-height: 54px;
    margin-bottom: 4px;
    padding: 7px 8px;
    align-items: stretch;
    -unity-text-align: upper-left;
    background-color: #202930;
    border-color: #35444f;
}

.reuse-row:hover { background-color: #283640; border-color: #658297; }
.reuse-title { -unity-font-style: bold; color: #cdd7df; font-size: 10px; }
.reuse-id { color: #71818d; font-size: 8px; }
.reuse-reason { margin-top: 3px; color: #b8935b; font-size: 8px; }
.section-gap { margin-top: 16px; }

.evaluation-box {
    margin-top: 6px;
    padding: 8px;
    background-color: #151c21;
    border-width: 1px;
    border-color: #2e3a43;
    border-radius: 4px;
}

.evaluation-title { -unity-font-style: bold; color: #b9c6cf; font-size: 10px; }
.evaluation-copy { margin-top: 4px; color: #7f8e99; white-space: normal; font-size: 9px; }

.promote-action {
    min-height: 35px;
    margin-top: 12px;
    color: #f2d39f;
    background-color: #40331f;
    border-color: #80633a;
}

.promote-action:hover { background-color: #554326; border-color: #b0884e; }

.creative-workspace.creative-compact .creative-brief-pane { width: 252px; min-width: 232px; }
.creative-workspace.creative-compact .creative-review-pane { width: 276px; min-width: 250px; }
.creative-workspace.creative-compact .creative-candidate-pane { min-width: 360px; }
.creative-workspace.creative-compact .candidate-card { width: 48%; }
.creative-workspace.creative-compact .creative-brief-pane .studio-field { flex-direction: column; align-items: stretch; }
.creative-workspace.creative-compact .creative-brief-pane .studio-field > .unity-base-field__label { width: 100%; margin-bottom: 2px; }
.creative-workspace.creative-compact .creative-brief-pane .studio-field > .unity-base-field__input { margin-left: 0; min-width: 0; }
.creative-workspace.creative-compact .reference-pack-actions { min-height: 58px; height: 58px; max-height: 58px; flex-grow: 0; flex-wrap: wrap; }
.creative-workspace.creative-compact .reference-pack-actions > Button { width: 47%; height: 25px; max-height: 25px; flex-grow: 1; flex-shrink: 0; margin-bottom: 4px; }
.creative-workspace.creative-compact .candidate-toolbar { min-height: 68px; flex-wrap: wrap; }
.creative-workspace.creative-compact .compare-controls { margin-top: 4px; }
.creative-workspace.creative-compact .candidate-scroll { min-height: 170px; }
.creative-workspace.creative-compact .candidate-detail-box { min-height: 150px; height: 180px; max-height: 180px; flex-grow: 0; }
.creative-workspace.creative-compact .creative-command-bar { min-height: 72px; height: 72px; max-height: 72px; flex-grow: 0; flex-wrap: wrap; }
.creative-workspace.creative-compact .creative-command-bar Button { width: 23%; min-width: 106px; height: 28px; max-height: 28px; flex-grow: 1; flex-shrink: 0; margin-bottom: 4px; }
.creative-workspace.creative-narrow .creative-brief-pane { width: 252px; min-width: 230px; }
.creative-workspace.creative-narrow .creative-review-pane { width: 282px; min-width: 260px; }
.creative-workspace.creative-narrow .lifecycle-rail { display: none; }

.window-compact .breadcrumb { display: none; }
.window-compact .badge { padding-left: 6px; padding-right: 6px; }
.window-compact .toolbar-action { padding-left: 7px; padding-right: 7px; }
.window-compact .studio-mode-switch { min-width: 252px; }
.window-compact .studio-mode-switch .mode-button { min-width: 118px; padding-left: 6px; padding-right: 6px; }
.window-compact #thumbnails { display: none; }
.window-compact #showcase { display: none; }

/* VFX semantic property authoring v3 */
.semantic-inspector-tabs {
    height: 34px;
    min-height: 34px;
    flex-direction: row;
    margin-top: 6px;
    margin-bottom: 6px;
    background-color: #0f151b;
    border-bottom-width: 1px;
    border-bottom-color: #344654;
}

.semantic-inspector-tab {
    flex-grow: 1;
    height: 32px;
    color: #93a3af;
    background-color: #151e26;
    border-width: 0;
    border-bottom-width: 2px;
    border-bottom-color: transparent;
}

.semantic-inspector-tab:hover { color: #e7edf2; background-color: #1c2731; }
.semantic-inspector-tab:active { translate: 0 1px; background-color: #101820; }
.semantic-inspector-tab:focus { border-left-width: 1px; border-right-width: 1px; border-left-color: #55b9f0; border-right-color: #55b9f0; }
.semantic-inspector-tab.active { color: #f2f5f7; background-color: #233342; border-bottom-color: #38a9e8; }

.semantic-inspector-page { display: none; width: 100%; min-width: 0; flex-shrink: 0; overflow: hidden; }
.semantic-inspector-page.active { display: flex; }
.semantic-edit-scope {
    margin: 4px 0 2px 0;
    padding: 6px;
    border-width: 1px;
    border-color: #31566b;
    border-radius: 3px;
    background-color: #12222c;
}
.semantic-edit-scope .semantic-contract-note { color: #9fc2d5; margin-left: 4px; }
.semantic-group { margin-top: 4px; border-color: #344654; background-color: #151e26; }
.semantic-group > .unity-foldout__content { padding-left: 6px; padding-right: 6px; padding-bottom: 6px; }
.semantic-segment-grid { flex-direction: row; flex-wrap: wrap; justify-content: space-between; }
.semantic-segment-grid > .studio-field {
    width: 100%;
    min-width: 0;
    flex-basis: 100%;
    flex-grow: 1;
    margin-right: 0;
}
.manual-inspector .semantic-segment-grid > .studio-field > .unity-base-field__label {
    width: 110px;
    min-width: 110px;
    flex-basis: 110px;
}
.manual-inspector .semantic-segment-grid > .studio-field > .unity-base-field__input { min-width: 48px; flex-grow: 1; }
.semantic-timing-slider { min-height: 24px; }
.semantic-timing-slider .unity-base-slider__tracker { height: 5px; background-color: #263744; border-radius: 3px; }
.semantic-timing-slider .unity-base-slider__dragger { width: 12px; height: 16px; background-color: #58b7ea; border-width: 1px; border-color: #a9ddf8; border-radius: 3px; }
.semantic-timing-slider:hover .unity-base-slider__dragger { background-color: #7bcaf2; }
.semantic-derived-timing { width: 100%; height: 22px; margin: 3px 0; color: #b9c7d1; }
.semantic-derived-timing .unity-progress-bar__background { background-color: #18232b; border-color: #344654; }
.semantic-derived-timing .unity-progress-bar__progress { background-color: #315f78; }
.semantic-derived-timing .unity-progress-bar__title { color: #c9d6de; font-size: 9px; -unity-text-align: middle-left; padding-left: 6px; }
.semantic-contract-note { color: #93a3af; font-size: 9px; white-space: normal; margin-top: 3px; margin-bottom: 4px; }
.semantic-field-error { display: none; color: #f08a7e; font-size: 9px; white-space: normal; margin: -1px 4px 5px 116px; }
.semantic-field-error.visible { display: flex; }
.manual-inspector .studio-field.field-error > .unity-base-field__label { color: #f08a7e; }
.manual-inspector .studio-field.field-error > .unity-base-field__input { border-width: 1px; border-color: #c85f55; background-color: #351f1d; }
.semantic-profile-coverage { color: #b7d9eb; background-color: #132735; border-width: 1px; border-color: #31566c; border-radius: 3px; padding: 6px 8px; margin-top: 6px; margin-bottom: 4px; white-space: normal; }
.semantic-profile-actions { flex-direction: row; min-height: 30px; margin-top: 4px; }
.semantic-profile-actions > Button { flex-grow: 1; margin-right: 4px; }
.semantic-capability-foldout { margin-top: 6px; }
.semantic-property-capability-list { height: 264px; border-width: 1px; border-color: #2d4656; background-color: #101b23; }
.semantic-capability-row { height: 44px; padding: 4px 7px; border-bottom-width: 1px; border-bottom-color: #263b48; }
.semantic-capability-row-top { flex-direction: row; align-items: center; }
.semantic-capability-name { flex-grow: 1; color: #d7e2e9; font-size: 10px; overflow: hidden; white-space: nowrap; }
.semantic-capability-state { min-width: 60px; -unity-text-align: middle-center; border-radius: 3px; padding: 2px 5px; font-size: 9px; color: #b8c7d1; background-color: #273641; }
.semantic-capability-state.state-confirmed { color: #bcefa3; background-color: #24431e; }
.semantic-capability-state.state-partial { color: #f4d88f; background-color: #4a3b19; }
.semantic-capability-state.state-previewonly { color: #9fd8f5; background-color: #173b50; }
.semantic-capability-state.state-reserved,
.semantic-capability-state.state-readonly,
.semantic-capability-state.state-unsupported { color: #a9afb4; background-color: #303236; }
.semantic-capability-reason { color: #8195a3; font-size: 9px; overflow: hidden; white-space: nowrap; margin-top: 2px; }

.semantic-time-segment-bar {
    height: 18px;
    min-height: 18px;
    flex-direction: row;
    margin-top: 4px;
    border-width: 1px;
    border-color: #344654;
    background-color: #0f151b;
}

.semantic-time-segment { min-width: 2px; }
.semantic-time-segment.preroll { background-color: #596876; }
.semantic-time-segment.entry { background-color: #4da6e8; }
.semantic-time-segment.body { background-color: #45c878; }
.semantic-time-segment.exit { background-color: #e8a13d; }
.semantic-time-segment.cleanup { background-color: #6c7780; }

.semantic-curve-track {
    height: 142px;
    min-height: 142px;
    background-color: #0b1116;
    border-width: 1px;
    border-color: #344654;
}

.semantic-curve-command-row { flex-direction: row; align-items: center; margin-bottom: 2px; }
.semantic-curve-operation { flex-grow: 1; width: auto; min-width: 0; margin-right: 4px; }
.manual-inspector .semantic-curve-operation > .unity-base-field__label {
    width: 62px;
    min-width: 62px;
    flex-basis: 62px;
}
.semantic-curve-command-row > .unity-button { width: 62px; min-width: 62px; }
.semantic-curve-editor { width: 100%; min-width: 0; margin-right: 0; margin-bottom: 4px; }

.semantic-curve-legend { flex-direction: row; justify-content: space-between; margin-top: 3px; }
.semantic-curve-legend .curve-source { color: #73818b; }
.semantic-curve-legend .curve-semantic { color: #38a9e8; }
.semantic-curve-legend .curve-final { color: #f2f5f7; }
.semantic-inline-actions { flex-direction: row; margin-top: 6px; }
.semantic-inline-actions > * { flex-grow: 1; margin-right: 4px; }
.semantic-member-list { height: 146px; min-height: 74px; max-height: 218px; flex-grow: 0; border-width: 1px; border-color: #344654; }
.semantic-member-row { height: 70px; min-height: 70px; padding: 7px; border-bottom-width: 1px; border-bottom-color: #2a3945; background-color: #151e26; }
.semantic-member-row:hover { background-color: #1c2731; }
.semantic-member-name { color: #e7edf2; -unity-font-style: bold; white-space: normal; }
.semantic-member-meta { color: #93a3af; font-size: 9px; white-space: normal; }
.semantic-member-state { width: 100%; min-width: 0; margin-top: 4px; }
.semantic-member-state > .unity-base-field__input { min-width: 0; }
.semantic-member-summary { margin-bottom: 5px; }
.semantic-member-detail-title { margin-top: 8px; margin-bottom: 0; }
.semantic-member-property { width: 100%; min-width: 0; margin-bottom: 5px; }
.semantic-member-matrix { height: 304px; min-height: 190px; max-height: 380px; margin-bottom: 4px; border-width: 1px; border-color: #344654; background-color: #111920; }
.semantic-member-matrix .unity-scroll-view__content-viewport { overflow: hidden; }
.semantic-member-matrix .unity-scroll-view__content-container { min-width: 0; padding: 5px; }
.semantic-matrix-card { width: 100%; min-width: 0; margin-bottom: 6px; padding: 7px; border-width: 1px; border-color: #344654; border-radius: 3px; background-color: #151e26; }
.semantic-matrix-card:hover { border-color: #4a6578; background-color: #18242d; }
.semantic-matrix-card-header { width: 100%; min-width: 0; flex-direction: row; align-items: center; margin-bottom: 5px; }
.semantic-matrix-identity { min-width: 0; flex-grow: 1; margin-right: 8px; }
.semantic-matrix-name { color: #e7edf2; -unity-font-style: bold; white-space: normal; }
.semantic-matrix-meta { color: #8295a3; font-size: 9px; white-space: normal; margin-top: 2px; }
.semantic-matrix-total { width: 126px; min-width: 126px; flex-shrink: 0; }
.manual-inspector .semantic-matrix-total > .unity-base-field__label { width: 48px; min-width: 48px; flex-basis: 48px; }
.semantic-matrix-total > .unity-base-field__input { min-width: 66px; }
.semantic-matrix-property-grid { width: 100%; min-width: 0; flex-direction: row; flex-wrap: wrap; justify-content: space-between; }
.semantic-matrix-property { width: auto; min-width: 142px; flex-basis: 48%; flex-grow: 1; margin-right: 4px; margin-top: 3px; }
.manual-inspector .semantic-matrix-property > .unity-base-field__label { width: 44px; min-width: 44px; flex-basis: 44px; }
.semantic-matrix-property > .unity-base-field__input { min-width: 70px; flex-grow: 1; }
.semantic-matrix-property.unsupported { opacity: 0.55; }
.semantic-matrix-empty { height: 80px; color: #8295a3; -unity-text-align: middle-center; }
.semantic-raw-list, .semantic-diff-list { min-height: 260px; border-width: 1px; border-color: #344654; }
.semantic-raw-row, .semantic-diff-row { padding: 5px; min-height: 44px; border-bottom-width: 1px; border-bottom-color: #2a3945; }
.semantic-diff-path { color: #e7edf2; }
.semantic-diff-values { color: #93a3af; font-size: 9px; white-space: normal; }
.semantic-raw-json { min-height: 160px; margin-top: 6px; }
.semantic-raw-json .unity-text-field__input { font-size: 9px; white-space: normal; }
.semantic-experimental .unity-base-field__input { border-color: #c58af0; }
.semantic-invalid .unity-base-field__input { border-color: #e65b5b; background-color: #351f24; }


.skill-binding-toolbar {
    min-height: 72px;
    flex-direction: column;
    padding: 5px 10px 6px 10px;
    border-bottom-width: 1px;
    border-bottom-color: #344654;
    background-color: #131d25;
}

.skill-binding-context-row,
.skill-binding-actions-row {
    flex-direction: row;
    align-items: center;
}

.skill-binding-context-row {
    min-height: 30px;
}

.skill-binding-actions-row {
    min-height: 30px;
    padding-left: 78px;
    flex-wrap: wrap;
}

.skill-binding-title {
    min-width: 78px;
    color: #dbe8f1;
    -unity-font-style: bold;
}

.skill-binding-slot {
    width: 250px;
    margin-right: 8px;
}

.skill-binding-contract {
    min-width: 240px;
    flex-grow: 1;
    color: #8fa5b5;
    margin-right: 8px;
}

.skill-binding-action-status {
    flex-shrink: 0;
    min-width: 104px;
    max-width: 280px;
    margin-left: 4px;
    padding: 4px 8px;
    color: #8fa2ae;
    background-color: #141c21;
    border-width: 1px;
    border-color: #34454f;
    border-radius: 3px;
    font-size: 9px;
    -unity-text-align: middle-center;
}

.skill-binding-action-status.running {
    color: #83cfff;
    border-color: #3979a2;
    background-color: #172b38;
}

.skill-binding-action-status.success {
    color: #9bdd72;
    border-color: #47743b;
    background-color: #1c2d1c;
}

.skill-binding-action-status.error {
    color: #f08a7e;
    border-color: #81423c;
    background-color: #351f1d;
}

.skill-binding-actions-row > .unity-button {
    min-width: 96px;
    margin-left: 4px;
}
