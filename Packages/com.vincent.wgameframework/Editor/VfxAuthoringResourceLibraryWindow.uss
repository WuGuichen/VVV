.manual-inspector-scroll .unity-scroll-view__content-container { min-width: 0; }
.inspector-section-title { margin-bottom: 7px; color: #e0e8ed; font-size: 13px; -unity-font-style: bold; }
.summary-card { margin-bottom: 8px; padding: 8px; border-width: 1px; border-color: #334550; border-radius: 5px; background-color: #151e24; }
.summary-title { margin-bottom: 6px; color: #e6eef3; font-size: 12px; -unity-font-style: bold; }
.summary-row { min-height: 22px; flex-direction: row; justify-content: space-between; }
