.inspector-tabs { height: 38px; min-height: 38px; flex-direction: row; border-bottom-width: 1px; border-bottom-color: #34424d; }
.inspector-tab { flex-grow: 1; border-width: 0; border-radius: 0; background-color: transparent; color: #84939d; }
.inspector-tab:hover { color: #d5e2e9; background-color: #202c34; }
.inspector-tab.active { color: #e8f5fc; background-color: #243642; border-bottom-width: 2px; border-bottom-color: #52ade3; }
.manual-inspector-scroll { flex-grow: 1; padding: 9px; }
