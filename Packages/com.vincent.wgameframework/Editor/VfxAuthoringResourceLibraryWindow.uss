.legacy-camera-preset-bindings { display: none; }
.character-preview-context-toggle { height: 28px; min-width: 104px; margin-left: 5px; padding-left: 7px; padding-right: 7px; color: #9babb5; border-color: #42545f; background-color: #1c272e; }
