.vfx-window {
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
    background-color: #11161b;
    color: #cad3dc;
}

.vfx-window Button {
    min-height: 26px;
    color: #c7d0d9;
    background-color: #272e35;
    border-width: 1px;
    border-color: #46515b;
    border-radius: 4px;
    transition-property: background-color, border-color, color, translate;
    transition-duration: 0.08s;
}

.vfx-window Button:hover {
    color: #ffffff;
    background-color: #33414d;
    border-color: #6d8799;
}

.vfx-window Button:active {
    color: #ffffff;
    background-color: #1f6594;
    border-color: #79bcea;
    translate: 0 1px;
}

.vfx-window Button:focus {
    border-color: #65afe2;
}

.vfx-window Button:disabled {
    color: #69737d;
    background-color: #20262b;
    border-color: #303840;
    opacity: 0.5;
}

.topbar {
    height: 46px;
    min-height: 46px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    padding-left: 12px;
    padding-right: 8px;
    background-color: #1d242a;
    border-bottom-width: 1px;
    border-bottom-color: #35404a;
}

.breadcrumb {
    margin-right: 14px;
    font-size: 13px;
    -unity-font-style: bold;
    color: #e0e8ef;
    white-space: nowrap;
}

.mode-switch {
    height: 30px;
    flex-direction: row;
    padding: 2px;
    background-color: #12171b;
    border-width: 1px;
    border-color: #333e47;
    border-radius: 6px;
}

.mode-button {
    min-width: 84px;
    height: 24px;
    min-height: 24px;
    margin: 0;
    background-color: transparent;
    border-color: transparent;
    color: #89959f;
}

.mode-button:hover {
    background-color: #26313a;
    border-color: #3c4b57;
}

.mode-button.mode-selected {
    color: #ffffff;
    background-color: #245f8b;
    border-color: #5ba7dc;
}

.top-spacer { flex-grow: 1; }

.badge {
    height: 27px;
    margin-left: 5px;
    padding-left: 9px;
    padding-right: 9px;
    border-radius: 4px;
    background-color: #293139;
    color: #aeb8c1;
    -unity-text-align: middle-center;
    white-space: nowrap;
}

.badge--good {
    color: #a2eb64;
    background-color: #1b2918;
    border-width: 1px;
    border-color: #598e2d;
}

.toolbar-action {
    height: 28px;
    min-height: 28px;
    margin-left: 6px;
    padding-left: 10px;
    padding-right: 10px;
    white-space: nowrap;
}

.workspace {
    flex-grow: 1;
    min-height: 0;
    flex-shrink: 1;
    flex-direction: row;
}

.sidebar {
    width: 244px;
    min-width: 218px;
    padding: 13px 12px 8px;
    background-color: #192027;
    border-right-width: 1px;
    border-right-color: #35404a;
}

.section-title {
    font-size: 16px;
    -unity-font-style: bold;
    color: #e1e8ee;
}

.section-subtitle {
    margin-top: 2px;
    margin-bottom: 10px;
    font-size: 10px;
    color: #71808c;
}

.micro-title {
    margin-top: 10px;
    margin-bottom: 5px;
    font-size: 9px;
    letter-spacing: 1px;
    color: #77848f;
}

.groups-title { margin-top: 16px; }
.search { margin-bottom: 5px; }
.filter { margin-top: 2px; margin-bottom: 2px; }
.filter > .unity-base-field__label { width: 58px; color: #8d99a4; }
.categories { flex-grow: 1; min-height: 0; }

.category-section {
    margin-top: 12px;
    margin-left: 8px;
    margin-bottom: 3px;
    font-size: 9px;
    color: #687581;
}

.category-button {
    height: 31px;
    min-height: 31px;
    margin-top: 1px;
    margin-bottom: 1px;
    padding-left: 9px;
    padding-right: 7px;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    -unity-text-align: middle-left;
    background-color: transparent;
    border-color: transparent;
    color: #b8c2cb;
}

.category-button:hover { background-color: #25323c; }

.category-button.selected-category {
    color: #f2f6f9;
    background-color: #253c4d;
    border-left-width: 3px;
    border-left-color: #4fa3dc;
}

.category-count {
    min-width: 25px;
    padding-left: 6px;
    padding-right: 6px;
    border-radius: 8px;
    background-color: #252d34;
    color: #84929e;
    -unity-text-align: middle-center;
    font-size: 9px;
}

.center-pane {
    min-width: 300px;
    flex-grow: 1;
    background-color: #13191e;
}

.content-header {
    height: 49px;
    min-height: 49px;
    padding: 7px 12px;
    border-bottom-width: 1px;
    border-bottom-color: #303a43;
}

.pane-title {
    font-size: 15px;
    -unity-font-style: bold;
    color: #dce4eb;
}

.subtle { color: #778590; font-size: 10px; }
.effect-grid { flex-grow: 1; border-width: 0; }

.card-row {
    height: 204px;
    flex-direction: row;
    padding: 5px;
}

.effect-card {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    height: 194px;
    margin: 4px;
    padding: 0 0 7px;
    align-items: stretch;
    -unity-text-align: upper-left;
    background-color: #20272d;
    border-width: 1px;
    border-color: #37434c;
    border-radius: 6px;
    overflow: hidden;
}

.effect-card:hover {
    background-color: #252e35;
    border-color: #657b8c;
    translate: 0 -1px;
}

.effect-card:active { translate: 0 1px; }

.effect-card.selected {
    background-color: #2c2921;
    border-width: 2px;
    border-color: #e68c21;
}

.effect-card.recipe-card { background-color: #202a31; }
.effect-card.primitive-card { background-color: #242831; }
.effect-card.exemplar-card { border-color: #8b6f2d; }
.effect-card.placeholder-card { border-color: #7a4a2a; }
.effect-card.placeholder-card:hover { border-color: #c87832; }
.effect-card.candidate-card { border-color: #5e7180; }
.effect-card.production-card { border-color: #4b7c3b; }

.card-image {
    height: 107px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    background-color: #080b0e;
    -unity-background-scale-mode: scale-and-crop;
}

.card-kind {
    position: absolute;
    left: 7px;
    top: 7px;
    padding: 3px 6px;
    border-radius: 3px;
    background-color: rgba(17, 24, 30, 0.88);
    color: #8fbcda;
    font-size: 9px;
}

.thumbnail-placeholder { color: #63717c; font-size: 10px; }
.card-title { margin: 6px 8px 0; -unity-font-style: bold; font-size: 12px; color: #edf2f6; }
.card-id { margin: 0 8px; color: #7d8994; font-size: 9px; white-space: nowrap; overflow: hidden; }
.card-chips { margin: 4px 8px 0; color: #d9a45f; font-size: 9px; }
.card-meta { margin: 3px 8px 0; color: #92a0ac; font-size: 9px; }

.inspector-pane {
    width: 510px;
    min-width: 415px;
    background-color: #1a2127;
    border-left-width: 1px;
    border-left-color: #35404a;
}

.preview-toolbar {
    height: 37px;
    min-height: 37px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    padding: 4px 7px;
}

.icon-button {
    width: 31px;
    min-width: 31px;
    height: 27px;
    min-height: 27px;
    margin-right: 3px;
    padding: 0;
    -unity-text-align: middle-center;
    font-size: 13px;
}

.preview-toolbar Toggle { width: 68px; }
.preview-toolbar Slider { min-width: 94px; flex-grow: 1; }
.preview-toolbar DropdownField { width: 91px; }
.preview-toolbar Button.playback-active { color: #ffffff; background-color: #2f6e9f; border-color: #67afe2; }

.playback-status {
    min-width: 52px;
    margin-left: 3px;
    margin-right: 6px;
    padding: 3px 7px;
    border-radius: 4px;
    -unity-text-align: middle-center;
    font-size: 10px;
}

.playback-status.playing { color: #9be76a; background-color: #20371e; }
.playback-status.paused { color: #ffd16a; background-color: #3b321d; }
.playback-status.stopped { color: #abb5bd; background-color: #2d353c; }

.preview-host {
    height: 270px;
    flex-shrink: 0;
    background-color: #06090b;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-color: #35404a;
}

.preview-host #preview-canvas { flex-grow: 1; }

.selection-header {
    height: 54px;
    min-height: 54px;
    flex-shrink: 0;
    padding: 8px 10px;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.selection-copy { flex-grow: 1; min-width: 0; }
.selection-title { font-size: 15px; -unity-font-style: bold; color: #edf2f6; }

.review-pill {
    margin-left: 8px;
    padding: 5px 9px;
    color: #f0a43b;
    background-color: #372919;
    border-radius: 4px;
}

.review-pill.ready { color: #a5eb6a; background-color: #20351e; }

.tabs {
    height: 36px;
    min-height: 36px;
    flex-shrink: 0;
    flex-direction: row;
    border-bottom-width: 1px;
    border-bottom-color: #3a454e;
}

.vfx-tab {
    flex-grow: 1;
    margin: 0;
    border-width: 0;
    border-radius: 0;
    background-color: transparent;
    color: #96a2ac;
}

.vfx-tab:hover { color: #e8eef3; background-color: #263039; }

.vfx-tab.active {
    color: #f3f7fa;
    background-color: #27343e;
    border-bottom-width: 3px;
    border-bottom-color: #4c9ed7;
}

.tab-content { flex-grow: 1; min-height: 90px; padding: 8px; overflow: hidden; }
.tab-content .unity-scroll-view__content-viewport { overflow: hidden; }
.tab-content .unity-scroll-view__content-container { min-width: 0; }

.detail-row {
    flex-direction: row;
    flex-wrap: wrap;
    min-width: 0;
    margin-bottom: 3px;
    padding: 6px 8px;
    background-color: #222a30;
    border-radius: 3px;
}

.detail-key { width: 124px; flex-shrink: 0; color: #84919c; }
.detail-value { flex-grow: 1; flex-basis: 180px; min-width: 0; white-space: normal; overflow: hidden; color: #ccd5dc; }
.review-field { margin-bottom: 7px; }
.review-field > .unity-base-field__label { width: 86px; color: #84919c; }
.review-description { min-height: 86px; }
.review-description .unity-text-field__input { min-height: 72px; white-space: normal; }
.empty-state { margin: 20px; color: #76848f; -unity-text-align: middle-center; }

.actions {
    height: 38px;
    min-height: 38px;
    flex-shrink: 0;
    flex-direction: row;
    padding: 4px 6px;
}

.actions Button { flex-grow: 1; margin-left: 2px; margin-right: 2px; }
.primary { color: #ffffff; background-color: #28679c; border-color: #4d95cc; }
.primary:hover { background-color: #347bb3; border-color: #74b9e8; }
.draft { background-color: #3b3428; border-color: #6b5735; }
.danger-quiet { color: #d8a0a0; border-color: #654646; }

.creative-workspace {
    display: none;
    flex-grow: 1;
    min-height: 0;
    background-color: #11171c;
}

.studio-mode-switch { flex-direction: row; min-width: 470px; }
.studio-mode-switch .mode-button { min-width: 132px; }
.studio-mode-switch .source-import-mode-button { min-width: 112px; color: #cfeeff; }
.topbar-studio-switch { display: none; margin-left: 8px; }
.topbar-creative-action { display: none; min-width: 130px; margin-left: 7px; }
.badge--production { color: #c3d0d9; border-color: #3e5260; background-color: #18232b; }
.boundary-help-button { width: 28px; min-width: 28px; padding-left: 0; padding-right: 0; color: #8fa6b5; -unity-font-style: bold; }
.boundary-help-button:hover { color: white; border-color: #5b87a0; background-color: #223743; }

.manual-workspace { position: relative; flex-grow: 1; min-height: 0; flex-direction: column; overflow: hidden; background-color: #0f151a; }
.manual-draft-toolbar { height: 46px; min-height: 46px; flex-shrink: 0; flex-direction: row; align-items: center; padding: 5px 8px; border-bottom-width: 1px; border-bottom-color: #40515d; background-color: #19232a; }
.manual-draft-current { width: 330px; height: 34px; min-width: 220px; margin-right: 5px; flex-direction: row; align-items: center; padding: 3px 6px 3px 9px; border-width: 1px; border-color: #41545f; border-radius: 5px; background-color: #111a20; }
.manual-draft-current:hover { border-color: #5a8eaa; background-color: #17252e; }
.manual-draft-current:active { border-color: #58b7ea; background-color: #193142; }
.manual-draft-current-copy { flex-grow: 1; min-width: 0; }
.manual-draft-current-name { color: #e3edf3; font-size: 11px; -unity-font-style: bold; white-space: nowrap; overflow: hidden; }
.manual-draft-current-id,
.manual-draft-current-meta { display: none; }
.manual-draft-current-chevron { width: 20px; color: #8eb7ce; font-size: 15px; -unity-text-align: middle-center; }
.manual-draft-toolbar > Button { height: 28px; min-width: 58px; margin-right: 5px; padding-left: 8px; padding-right: 8px; }
.manual-draft-toolbar > .draft-browser-open { min-width: 78px; color: #b9dced; border-color: #4c7186; background-color: #203541; }
.manual-draft-toolbar > .draft-browser-open:hover { color: white; border-color: #68a7ca; background-color: #28516a; }
.manual-draft-toolbar > .add-material-button { min-width: 96px; color: #f3fbff; border-color: #3f91be; background-color: #17658e; -unity-font-style: bold; }
.manual-draft-toolbar > .add-material-button:hover { border-color: #76c9f1; background-color: #2584b6; }
.manual-draft-toolbar > Button:hover { background-color: #263a47; border-color: #4f7790; color: #d8efff; }
.manual-draft-toolbar > .destructive { color: #e7b9bd; border-color: #74444a; background-color: #39252a; }
.manual-draft-toolbar > .destructive:hover { color: white; border-color: #a95f68; background-color: #64343b; }
.manual-draft-toolbar-spacer { flex-grow: 1; min-width: 4px; }
.composition-state-strip { flex-direction: row; align-items: center; margin-right: 4px; }
.composition-state-badge { height: 22px; min-width: 72px; margin-left: 3px; padding: 3px 7px; border-width: 1px; border-radius: 11px; color: #9aabb5; border-color: #3b4b55; background-color: #172027; font-size: 8px; -unity-text-align: middle-center; white-space: nowrap; }
.composition-state-badge.state-success { color: #a7df83; border-color: #47743b; background-color: #1c2d1c; }
.composition-state-badge.state-warning { color: #efc06c; border-color: #755c2d; background-color: #302819; }
.composition-state-badge.state-error { color: #f29a90; border-color: #81423c; background-color: #351f1d; }
.composition-state-badge.state-neutral { color: #9aabb5; border-color: #3b4b55; background-color: #172027; }
.composition-state-badge.state-candidate { color: #e7c36d; border-color: #7a6131; background-color: #302817; }
.composition-state-badge.state-production { color: #9fe67c; border-color: #4f803c; background-color: #1d321d; }
.composition-save-status { min-width: 82px; max-width: 150px; height: 25px; margin-right: 2px; padding: 4px 7px; color: #8fa2ae; background-color: #141c21; border-width: 1px; border-color: #34454f; border-radius: 3px; font-size: 9px; -unity-text-align: middle-center; }
.composition-save-status.save-success { color: #9bdd72; border-color: #47743b; background-color: #1c2d1c; }
.composition-save-status.save-warning { color: #edbd65; border-color: #755c2d; background-color: #302819; }
.composition-save-status.save-error { color: #f08a7e; border-color: #81423c; background-color: #351f1d; }
.draft-browser-overlay { display: none; position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: rgba(4, 7, 9, 0.58); }
.draft-browser-panel { position: absolute; left: 68px; top: 58px; width: 620px; height: 475px; border-width: 1px; border-color: #557183; border-radius: 7px; background-color: #121b21; overflow: hidden; }
.draft-browser-header { height: 60px; min-height: 60px; flex-direction: row; align-items: center; padding: 8px 9px 8px 13px; background-color: #202d36; border-bottom-width: 1px; border-bottom-color: #40525f; }
.draft-browser-heading-copy { flex-grow: 1; min-width: 0; }
.draft-browser-title { color: #eef5f9; font-size: 14px; -unity-font-style: bold; }
.draft-browser-subtitle { margin-top: 3px; color: #8196a3; font-size: 9px; }
.draft-browser-count { min-width: 67px; margin-right: 7px; }
.draft-browser-close { width: 29px; min-width: 29px; height: 29px; padding: 0; color: #afbec8; background-color: #172128; border-color: #4b5e6b; font-size: 17px; }
.draft-browser-close:hover { color: white; background-color: #583238; border-color: #92505a; }
.draft-browser-search { height: 30px; margin: 8px 10px 6px 10px; }
.draft-browser-list { flex-grow: 1; margin: 0 10px 6px 10px; border-width: 1px; border-color: #2f414d; background-color: #0d151a; }
.draft-browser-list .unity-list-view__item { padding: 0; }
.draft-browser-row { height: 88px; margin: 2px 3px; padding: 7px 9px; border-width: 1px; border-color: #31434e; border-radius: 5px; background-color: #19242b; }
.draft-browser-row:hover { border-color: #557c94; background-color: #21313b; }
.draft-browser-row.draft-current { border-color: #3f93c2; background-color: #1a3545; }
.draft-browser-row-header { height: 19px; flex-direction: row; align-items: center; }
.draft-browser-row-name { flex-grow: 1; min-width: 0; color: #e4edf3; font-size: 11px; -unity-font-style: bold; white-space: nowrap; overflow: hidden; }
.draft-browser-row-badge { display: none; height: 18px; min-width: 38px; margin-left: 6px; padding: 1px 6px; border-radius: 9px; color: #8fddff; background-color: #204f68; font-size: 8px; -unity-text-align: middle-center; }
.draft-browser-row.draft-current .draft-browser-row-badge { display: flex; }
.draft-browser-row-id { margin-top: 2px; color: #7590a0; font-size: 8px; white-space: nowrap; overflow: hidden; }
.draft-browser-row-meta { margin-top: 3px; color: #a8bac5; font-size: 8px; white-space: nowrap; overflow: hidden; }
.draft-browser-row-states { height: 21px; margin-top: 4px; flex-direction: row; align-items: center; }
.draft-browser-row-states .composition-state-badge { height: 19px; min-width: 68px; margin-left: 0; margin-right: 4px; padding: 2px 6px; font-size: 7px; }
.draft-browser-row-effect { color: #d5a963; }
.draft-browser-empty { display: none; position: absolute; left: 10px; right: 10px; top: 150px; color: #718793; font-size: 11px; -unity-text-align: middle-center; }
.draft-browser-footer { height: 44px; min-height: 44px; flex-direction: row; align-items: center; padding: 6px 9px 6px 12px; border-top-width: 1px; border-top-color: #334650; background-color: #182229; }
.draft-browser-footer-copy { flex-grow: 1; color: #738894; font-size: 8px; }
.draft-browser-footer > Button { height: 28px; min-width: 90px; margin-left: 5px; }
.source-prefab-import-workspace { display: none; flex-grow: 1; min-height: 0; flex-direction: column; overflow: hidden; background-color: #0d151a; }
.source-prefab-import-context { height: 42px; min-height: 42px; flex-direction: row; align-items: center; padding: 5px 10px; border-bottom-width: 1px; border-bottom-color: #3c515d; background-color: #17232b; }
.source-prefab-import-context-label { color: #8298a5; font-size: 9px; }
.source-prefab-import-draft { margin-left: 2px; color: #e3edf3; font-size: 11px; -unity-font-style: bold; }
.source-prefab-import-back { height: 28px; margin-left: 12px; color: #b9dced; border-color: #4c7186; background-color: #203541; }
.source-prefab-import-dirty { margin-left: 10px; color: #889aa5; font-size: 9px; }
.source-prefab-import-dirty.dirty { color: #dfb65e; }
.source-prefab-import-context-spacer { flex-grow: 1; }
.source-prefab-import-index-status { color: #9eb6c3; font-size: 9px; }
.source-prefab-import-body { flex-grow: 1; min-height: 0; flex-direction: row; }
.source-prefab-import-column { min-height: 0; padding: 9px; border-right-width: 1px; border-right-color: #314550; }
.source-prefab-import-left { width: 590px; min-width: 560px; max-width: 680px; background-color: #132027; }
.source-prefab-import-center { flex-grow: 1; min-width: 420px; background-color: #10181e; }
.source-prefab-import-right { width: 25%; min-width: 335px; max-width: 450px; border-right-width: 0; background-color: #142027; }
.source-prefab-import-column-title { height: 25px; color: #e7f0f5; font-size: 12px; -unity-font-style: bold; }
.source-prefab-import-browser { flex-grow: 1; min-height: 0; flex-direction: row; }
.source-prefab-import-folder-panel { width: 200px; min-width: 200px; min-height: 0; margin-right: 8px; border-width: 1px; border-color: #344b57; border-radius: 4px; background-color: #10191f; }
.source-prefab-import-folder-header { height: 32px; min-height: 32px; flex-direction: row; align-items: center; padding: 3px 5px 3px 8px; border-bottom-width: 1px; border-bottom-color: #2d424d; background-color: #17242b; }
.source-prefab-import-folder-title { flex-grow: 1; color: #c9dbe4; font-size: 10px; -unity-font-style: bold; }
