.element-quick-preview-controls > .element-quick-preview-set-icon:hover { color: white; background-color: #2f6686; border-color: #6bb8e2; }

.composition-toolbar { height: auto; min-height: 48px; flex-shrink: 0; flex-direction: row; flex-wrap: wrap; align-content: center; align-items: center; padding: 4px 7px; border-bottom-width: 1px; border-bottom-color: #34434e; background-color: #1b242b; }
.preview-layout-button { height: 28px; min-width: 67px; margin-left: 4px; padding-left: 7px; padding-right: 7px; }
.preview-heading { min-width: 138px; }
