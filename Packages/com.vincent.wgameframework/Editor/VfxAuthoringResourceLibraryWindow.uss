.character-preview-row > Button:hover { background-color: #263a47; border-color: #4f7790; color: #d8efff; }
.character-preview-row > Button:active { background-color: #2d739f; border-color: #65b6e8; color: white; }
.character-preview-status { margin-top: 2px; color: #7f919e; font-size: 9px; }
.character-preview-status.status-warning { color: #d7a34c; }
.composition-preview-host { flex-grow: 1; flex-shrink: 1; min-height: 300px; margin: 0; background-color: #05080a; border-bottom-width: 1px; border-bottom-color: #33444f; flex-direction: row; position: relative; }
.composition-layer-splitter { height: 9px; min-height: 9px; flex-shrink: 0; align-items: center; justify-content: center; background-color: #11191f; border-top-width: 1px; border-bottom-width: 1px; border-color: #344650; }
.composition-layer-splitter:hover { background-color: #1c2c36; border-color: #5b879f; }
.composition-layer-splitter-handle { width: 58px; height: 3px; border-radius: 2px; background-color: #607783; }
.composition-layer-region { height: 260px; min-height: 112px; max-height: 520px; flex-shrink: 0; overflow: hidden; }
