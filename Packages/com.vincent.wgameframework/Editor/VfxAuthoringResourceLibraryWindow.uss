.character-preview-target-row .character-preview-field { width: 190px; }
.character-preview-phase-badge { min-width: 118px; height: 22px; margin-right: 7px; padding: 3px 8px; border-radius: 3px; background-color: #18354a; color: #71c6f3; -unity-text-align: middle-center; -unity-font-style: bold; }
.character-preview-override-summary { flex-grow: 1; color: #8398a5; font-size: 9px; }
.character-preview-override-summary.has-overrides { color: #e5ad55; }
.character-preview-target-row > Button { min-width: 116px; height: 24px; }
.character-preview-target-row > Button:hover { background-color: #263a47; border-color: #4f7790; color: #d8efff; }
.character-preview-target-row > Button:disabled { opacity: 0.45; }
.character-preview-row { flex-direction: row; align-items: center; min-height: 30px; margin-top: 3px; }
.character-preview-field { width: 150px; margin-right: 7px; }
.character-preview-wide { width: 230px; }
.character-preview-speed { width: 190px; margin-right: 7px; }
