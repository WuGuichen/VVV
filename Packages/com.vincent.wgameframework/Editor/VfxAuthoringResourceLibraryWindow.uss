.temporary-element-banner { display: none; position: absolute; right: 12px; top: 12px; height: 34px; max-width: 650px; flex-direction: row; align-items: center; padding: 4px 5px 4px 9px; border-width: 1px; border-color: #b66a23; border-radius: 5px; background-color: rgba(40, 30, 20, 0.96); }
.temporary-element-kicker { color: #ffad4a; font-size: 10px; -unity-font-style: bold; margin-right: 8px; }
.temporary-element-name { color: #f3f6f8; font-size: 11px; -unity-font-style: bold; max-width: 230px; white-space: nowrap; overflow: hidden; margin-right: 8px; }
.temporary-element-mode { color: #8fcbea; font-size: 9px; margin-right: 7px; }
.temporary-element-mode.solo { color: #ffbd63; -unity-font-style: bold; }
.temporary-element-safe { color: #a8947c; font-size: 9px; margin-right: 7px; }
.temporary-element-banner > Button { height: 25px; min-width: 46px; padding-left: 7px; padding-right: 7px; margin-left: 3px; }
.temporary-element-banner > Button:hover { color: white; background-color: #6c4524; border-color: #dc8a36; }
.composition-preview-canvas { flex-grow: 1; min-width: 0; }
.preview-empty-state { position: absolute; left: 0; right: 0; top: 0; bottom: 0; align-items: center; justify-content: center; background-color: #070b0e; }
.preview-empty-icon { font-size: 30px; color: #3f7b9f; }
.preview-empty-title { margin-top: 5px; color: #b8cad6; font-size: 14px; -unity-font-style: bold; }
.preview-empty-copy { margin-top: 4px; color: #687d8b; font-size: 10px; }
.composition-timeline-row { height: 29px; flex-direction: row; align-items: center; padding: 0 8px; background-color: #182128; }
.time-readout { width: 96px; color: #b8c7d1; font-size: 10px; }
.composition-timeline { flex-grow: 1; margin-left: 5px; }
.timeline-ruler { height: 19px; flex-direction: row; justify-content: space-between; padding-left: 102px; padding-right: 14px; background-color: #141c22; border-bottom-width: 1px; border-bottom-color: #34434e; }
.timeline-ruler Label { color: #637480; font-size: 8px; }
.layer-toolbar { height: 38px; min-height: 38px; flex-direction: row; align-items: center; padding: 5px 8px; background-color: #1a232a; }
.layer-toolbar Button { flex-grow: 0; min-width: 38px; height: 25px; margin-left: 4px; }
.layer-toolbar .layer-primary-action { min-width: 70px; padding-left: 8px; padding-right: 8px; }
.layer-toolbar .layer-primary-action.primary { min-width: 82px; }
.layer-toolbar-divider { width: 1px; height: 20px; margin-left: 7px; margin-right: 3px; background-color: #3a4a54; }
.layer-table-header { height: 26px; min-height: 26px; flex-direction: row; align-items: center; padding-left: 5px; padding-right: 5px; background-color: #131a20; border-top-width: 1px; border-bottom-width: 1px; border-color: #31404a; }
.layer-table-header Label { color: #6f808c; font-size: 8px; }
.layer-col-controls { width: 70px; -unity-text-align: middle-center; }
.layer-col-preview { width: 47px; -unity-text-align: middle-center; }
.layer-col-name { width: 150px; }
.layer-col-role { width: 62px; }
.layer-col-timeline { flex-grow: 1; }
.layer-col-range { width: 76px; -unity-text-align: middle-center; }
.layer-col-number { width: 47px; -unity-text-align: middle-center; }
.layer-col-status { width: 35px; -unity-text-align: middle-center; }
.layer-list-host { flex-grow: 1; min-height: 175px; position: relative; }
.composition-layer-list { flex-grow: 1; height: auto; min-height: 175px; border-width: 0; background-color: #11181e; }
.composition-layer-list .unity-list-view__item,
.composition-layer-list .unity-collection-view__item { min-height: 58px; padding: 0; border-bottom-width: 1px; border-bottom-color: #27343d; background-color: transparent; }
.composition-layer-list .unity-list-view__item--selected,
.composition-layer-list .unity-collection-view__item--selected { background-color: #183044; border-left-width: 3px; border-left-color: #55b8ee; }
.composition-layer-list .unity-list-view__item--selected .layer-stack-row,
.composition-layer-list .unity-collection-view__item--selected .layer-stack-row { background-color: #1d3240; }
.layer-stack-row { height: 58px; flex-direction: row; align-items: center; padding: 5px 5px 5px 2px; border-left-width: 3px; border-left-color: transparent; }
.layer-stack-row.phase-build { border-left-color: #4aa8ff; }
.layer-stack-row.phase-rebuild { border-left-color: #9b7cff; }
.layer-stack-row.phase-loop { border-left-color: #55c878; }
.layer-stack-row.phase-complete { border-left-color: #f0a33a; }
.layer-stack-row.phase-dissipate { border-left-color: #8d98a6; }
.layer-stack-row:hover { background-color: #1d2a33; }
.layer-stack-row.layer-drop-target { background-color: #263d4b; border-top-width: 2px; border-top-color: #53aee8; }
.layer-stack-row.layer-disabled { opacity: 0.48; }
.layer-drag-handle { width: 16px; height: 34px; margin-right: 2px; color: #60727e; font-size: 12px; -unity-text-align: middle-center; }
.layer-drag-handle:hover { color: #b7c7d0; background-color: #24333d; }
.layer-inline-button { width: 24px; height: 24px; padding: 0; margin-right: 3px; background-color: transparent; border-color: transparent; color: #96a8b4; }
.layer-inline-button.inline-active { color: #5bbbf1; background-color: #1d4056; border-color: #35789d; }
.layer-thumb { width: 40px; height: 40px; margin-right: 7px; background-color: #070b0e; border-width: 1px; border-color: #2b3b45; -unity-background-scale-mode: scale-and-crop; }
.layer-name-block { width: 150px; min-width: 110px; }
.layer-name { color: #dce6ec; font-size: 10px; -unity-font-style: bold; white-space: nowrap; }
.layer-subtitle { margin-top: 2px; color: #6f818d; font-size: 8px; }
.layer-role { width: 57px; height: 21px; margin-right: 5px; border-radius: 3px; background-color: #51341f; color: #ffc26a; font-size: 8px; -unity-text-align: middle-center; }
.layer-time-host { flex-grow: 1; min-width: 110px; height: 24px; margin-right: 5px; background-color: #121b21; border-width: 1px; border-color: #293944; border-radius: 3px; position: relative; }
.layer-time-host:hover { border-color: #486476; }
.layer-time-bar { position: absolute; top: 3px; bottom: 3px; min-width: 18px; flex-direction: row; align-items: center; justify-content: center; background-color: #d86f29; border-width: 1px; border-color: #f08a42; border-radius: 3px; }
.layer-time-bar:hover { background-color: #eb7b2e; border-color: #ffad68; }
.layer-time-bar.phase-overflow { background-color: #9a4d2d; border-color: #ff765a; }
.layer-time-bar.phase-overflow .layer-time-resize { background-color: #ff765a; }
.layer-time-label { color: #fff1df; font-size: 8px; -unity-text-align: middle-center; }
.layer-time-resize { position: absolute; right: 0; top: 0; bottom: 0; width: 8px; background-color: #ffaf69; border-top-right-radius: 2px; border-bottom-right-radius: 2px; }
.layer-time-resize:hover { background-color: #ffe0bc; }
.layer-time-playhead { position: absolute; top: -4px; bottom: -4px; width: 2px; margin-left: -1px; background-color: #54c8ff; }
.layer-time-playhead-cap { position: absolute; left: -3px; top: -1px; width: 8px; height: 5px; background-color: #8cddff; border-bottom-left-radius: 3px; border-bottom-right-radius: 3px; }
.layer-range { width: 74px; color: #aab9c2; font-size: 8px; -unity-text-align: middle-center; }
.layer-number { width: 45px; color: #9aabb6; font-size: 9px; -unity-text-align: middle-center; }
.layer-status { width: 30px; color: #7dcc56; -unity-text-align: middle-center; }
.layer-status.warning { color: #f0a534; }
.layer-empty-state { position: absolute; left: 0; right: 0; top: 42px; color: #607581; -unity-text-align: middle-center; font-size: 11px; }
.current-frame-pill { min-width: 82px; height: 22px; margin-left: 6px; padding: 2px 7px; border-width: 1px; border-color: #326f91; border-radius: 4px; background-color: #17384c; color: #7bd4ff; font-size: 9px; -unity-text-align: middle-center; }
.composition-budget-row { height: 30px; min-height: 30px; flex-direction: row; align-items: center; padding: 4px 8px; background-color: #151e24; border-top-width: 1px; border-top-color: #31404a; }
.composition-budget-row > Label { width: 92px; color: #aab8c1; font-size: 9px; }
.composition-budget { flex-grow: 1; height: 16px; }
