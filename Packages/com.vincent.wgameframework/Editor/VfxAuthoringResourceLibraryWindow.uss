.phase-summary-complete { border-left-width: 3px; border-left-color: #f0a33a; }
.phase-summary-dissipate { border-left-width: 3px; border-left-color: #8d98a6; }
.speed-field { width: 116px; margin-left: 5px; }
.speed-field .unity-base-field__label { min-width: 31px; width: 31px; font-size: 9px; }
