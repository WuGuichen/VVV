.composition-control-row { height: auto; min-height: 44px; flex-shrink: 0; flex-direction: row; flex-wrap: wrap; align-items: stretch; border-bottom-width: 1px; border-bottom-color: #31404a; background-color: #141e25; }
.phase-summary-strip { flex-grow: 1; flex-shrink: 1; min-width: 600px; height: 43px; min-height: 43px; padding: 5px 5px; flex-direction: row; align-items: center; border-right-width: 1px; border-right-color: #34434c; background-color: #141e25; }
