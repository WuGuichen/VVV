<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs;ProductionBarrier.g.cs" />
    <Reference Include="nunit.framework"><HintPath>$(UserProfile)/.nuget/packages/nunit/3.13.1/lib/netstandard2.0/nunit.framework.dll</HintPath></Reference>
    <Compile Include="../../../Assets/Scripts/WGameFrameworkProject/CharacterTest/TacticalCard/TacticalLoadingFlow.cs" Link="Production/TacticalLoadingFlow.cs" />
    <Compile Include="../../../Assets/Scripts/WGameFrameworkProject/CharacterTest/Tests/EditMode/TacticalCard/TacticalLoadingFlowTests.cs" Link="Tests/TacticalLoadingFlowTests.cs" />
  </ItemGroup>
  <Target Name="ExtractProductionBarrier" BeforeTargets="BeforeBuild">
    <Exec Command="python &quot;$(MSBuildProjectDirectory)/extract_barrier.py&quot;" />
  </Target>
</Project>
