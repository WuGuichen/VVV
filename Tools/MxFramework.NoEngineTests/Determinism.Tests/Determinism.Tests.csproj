<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RepoRoot>../../..</RepoRoot>
    <PackageRoot>$(RepoRoot)/Packages/com.vincent.wgameframework</PackageRoot>
    <TestRoot>$(RepoRoot)/Assets/Scripts/WGameFrameworkProject/CharacterTest/Tests/EditMode</TestRoot>
    <TacticalRoot>$(RepoRoot)/Assets/Scripts/WGameFrameworkProject/CharacterTest/TacticalCard</TacticalRoot>
    <DependencyCache Condition="'$(DependencyCache)' == ''">$(UserProfile)/.nuget/packages</DependencyCache>
    <NUnitFrameworkPath Condition="'$(NUnitFrameworkPath)' == ''">$(DependencyCache)/nunit/3.13.1/lib/netstandard2.0/nunit.framework.dll</NUnitFrameworkPath>
    <NewtonsoftPath Condition="'$(NewtonsoftPath)' == ''">$(DependencyCache)/newtonsoft.json/13.0.3/lib/net6.0/Newtonsoft.Json.dll</NewtonsoftPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(TestRoot)/Runtime/TestCustomStateTypeIds.cs;$(TestRoot)/CharacterTestRuntimeTraceIds.cs" />
    <Compile Include="$(TestRoot)/CharacterTestNumericIds.cs;$(TestRoot)/CharacterTestActionIds.cs;$(TestRoot)/CharacterTestBulkIds.cs;$(RepoRoot)/Assets/Scripts/WGameFrameworkProject/CharacterTest/Runtime/World/CharacterTestAuthoredContentIds.cs" />
    <Compile Include="$(PackageRoot)/Combat/**/*.cs;$(PackageRoot)/CharacterAction/**/*.cs" Exclude="$(PackageRoot)/**/AssemblyInfo.cs" />
    <Compile Include="$(TestRoot)/Combat/GameplayBridge/CombatDamageApplicationSystemTests.cs;$(TestRoot)/Combat/GameplayBridge/CombatActionStateSyncSystemTests.cs;$(TestRoot)/CharacterAction/CharacterActionRunnerTests.cs;$(TestRoot)/CharacterAction/CharacterActionPhaseAuthorityTests.cs" />
    <Reference Include="nunit.framework"><HintPath>$(NUnitFrameworkPath)</HintPath></Reference>
    <Reference Include="Newtonsoft.Json"><HintPath>$(NewtonsoftPath)</HintPath></Reference>
    <Compile Include="$(PackageRoot)/Core/**/*.cs;$(PackageRoot)/Runtime/**/*.cs;$(PackageRoot)/Network/**/*.cs;$(PackageRoot)/Events/**/*.cs;$(PackageRoot)/Attributes/**/*.cs;$(PackageRoot)/Modifiers/**/*.cs;$(PackageRoot)/Gameplay/**/*.cs" Exclude="$(PackageRoot)/**/AssemblyInfo.cs" />
    <Compile Include="$(TacticalRoot)/MomentumLedger.cs;$(TacticalRoot)/SettleDetector.cs;$(TacticalRoot)/TacticalCardDefinition.cs;$(TacticalRoot)/TacticalCardEnums.cs;$(TacticalRoot)/TacticalCardInstance.cs;$(TacticalRoot)/TacticalCooldownTracker.cs;$(TacticalRoot)/TacticalDeckManager.cs;$(TacticalRoot)/TacticalTimeCoordinator.cs;$(TacticalRoot)/TacticalExecutionInput.cs;$(TacticalRoot)/TacticalPointMoveRules.cs" />
    <Compile Include="$(RepoRoot)/Assets/Scripts/WGameFrameworkProject/CharacterTest/Composition/CharacterTestFixedTickDriver.cs" />
    <Compile Include="$(TestRoot)/Runtime/RuntimeDeterministicRandomTests.cs;$(TestRoot)/Runtime/RuntimeFrameCommandReplayTests.cs;$(TestRoot)/Runtime/RuntimeReplayPlaybackTests.cs;$(TestRoot)/Runtime/RuntimeGoldenReplayFixtures.cs;$(TestRoot)/Runtime/RuntimeGoldenReplayHarnessTests.cs;$(TestRoot)/Runtime/RuntimeSnapshotDiffTests.cs;$(TestRoot)/Runtime/RuntimeHostTests.cs;$(TestRoot)/Runtime/RuntimeSaveStateTests.cs;$(TestRoot)/Runtime/RuntimeTimerSchedulerSaveStateTests.cs;$(TestRoot)/Runtime/RuntimeCheckpointBarrierTests.cs;$(TestRoot)/Network/NetworkSessionRunnerTests.cs;$(TestRoot)/Ability/GameplayComponentWorldSaveStateTests.cs;$(TestRoot)/Ability/GameplayComponentAuraSourceTests.cs;$(TestRoot)/Gameplay/GameplayScatterPressureTests.cs;$(TestRoot)/Ability/GameplayComponentStoreTests.cs;$(TestRoot)/Ability/GameplayComponentBuffModifierTests.cs;$(TestRoot)/TacticalCard/TacticalCardEngineTests.cs;$(TestRoot)/TacticalCard/TacticalTimeCoordinatorTests.cs" />
  </ItemGroup>
  <Target Name="RequireCachedDependencies" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(NUnitFrameworkPath)')" Text="Use an existing NUnit 3.13.1 DLL via NUnitFrameworkPath; this runner does not download dependencies." />
    <Error Condition="!Exists('$(NewtonsoftPath)')" Text="Use an existing Newtonsoft.Json 13.0.3 DLL via NewtonsoftPath; this runner does not download dependencies." />
  </Target>
</Project>
