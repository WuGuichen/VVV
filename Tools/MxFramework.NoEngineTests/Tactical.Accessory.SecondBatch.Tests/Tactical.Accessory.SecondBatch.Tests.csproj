<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RepoRoot>../../..</RepoRoot>
    <PackageRoot>$(RepoRoot)/Packages/com.vincent.wgameframework</PackageRoot>
    <TacticalRoot>$(RepoRoot)/Assets/Scripts/WGameFrameworkProject/CharacterTest/TacticalCard</TacticalRoot>
    <NUnitFrameworkPath Condition="'$(NUnitFrameworkPath)' == ''">$(UserProfile)/.nuget/packages/nunit/3.13.1/lib/netstandard2.0/nunit.framework.dll</NUnitFrameworkPath>
    <NewtonsoftPath Condition="'$(NewtonsoftPath)' == ''">$(UserProfile)/.nuget/packages/newtonsoft.json/13.0.3/lib/net6.0/Newtonsoft.Json.dll</NewtonsoftPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="nunit.framework"><HintPath>$(NUnitFrameworkPath)</HintPath></Reference>
    <Reference Include="Newtonsoft.Json"><HintPath>$(NewtonsoftPath)</HintPath></Reference>
    <!-- Existing noEngine contracts are source-linked, never stubbed or copied. Shared projects are not modified. -->
    <Compile Include="$(PackageRoot)/Core/**/*.cs;$(PackageRoot)/Runtime/**/*.cs;$(PackageRoot)/Network/**/*.cs;$(PackageRoot)/Events/**/*.cs;$(PackageRoot)/Attributes/**/*.cs;$(PackageRoot)/Modifiers/**/*.cs;$(PackageRoot)/Gameplay/**/*.cs;$(PackageRoot)/Combat/**/*.cs;$(PackageRoot)/CharacterAction/**/*.cs;$(PackageRoot)/CharacterControl/**/*.cs" Exclude="$(PackageRoot)/**/AssemblyInfo.cs" />
    <Compile Include="$(TacticalRoot)/MomentumLedger.cs;$(TacticalRoot)/TacticalAccessoryCombatEffects.cs;$(TacticalRoot)/TacticalDoubleEdgeDamageRules.cs" />
    <Compile Include="$(TacticalRoot)/TacticalAccessorySecondBatchRules.cs;$(TacticalRoot)/TacticalAccessorySecondBatchState.cs" />
    <Compile Include="$(RepoRoot)/Assets/Scripts/WGameFrameworkProject/CharacterTest/Tests/EditMode/TacticalCard/TacticalAccessorySecondBatchTests.cs" />
    <Compile Include="$(SecondBatchIndependentProbe)" Condition="'$(SecondBatchIndependentProbe)' != ''" />
  </ItemGroup>
  <Target Name="RequireCachedDependencies" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(NUnitFrameworkPath)')" Text="Provide an existing NUnit 3.13.1 DLL; this offline runner does not download dependencies." />
    <Error Condition="!Exists('$(NewtonsoftPath)')" Text="Provide an existing Newtonsoft.Json 13.0.3 DLL; this offline runner does not download dependencies." />
  </Target>
</Project>
