{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mxframework.invalid/schemas/upm/matrix-report-v1.schema.json",
  "title": "MxFramework UPM Consumer Matrix Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "type", "evidenceLevel", "candidate", "requiredRowCount", "requiredRows", "candidateEquality", "promotable", "reasons"],
  "properties": {
    "schemaVersion": {"const": 1},
    "type": {"const": "upm-consumer-matrix"},
    "evidenceLevel": {"const": "E2-matrix"},
    "requiredRowCount": {"type": "integer", "minimum": 1},
    "candidate": {
      "type": "object",
      "required": ["commit", "packageName", "packageVersion", "packageTreeHash", "workingTreeDirty"],
      "properties": {
        "commit": {"$ref": "#/$defs/commit"},
        "packageName": {"type": ["string", "null"]},
        "packageVersion": {"type": ["string", "null"]},
        "packageTreeHash": {"anyOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]},
        "workingTreeDirty": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "requiredRows": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/row"}},
    "candidateEquality": {
      "type": "object",
      "required": ["passed"],
      "properties": {"passed": {"type": "boolean"}},
      "additionalProperties": true
    },
    "promotable": {"type": "boolean"},
    "reasons": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "row": {
      "type": "object",
      "required": ["id", "sourceMode", "profile", "required", "report", "reportSha256", "passed", "eligible", "schemaValid", "artifactHashValid", "mutationClean", "testsComplete", "logsClean", "candidateEqual", "failureReason"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "sourceMode": {"enum": ["local", "pinned-git"]},
        "profile": {"enum": ["base", "with-fairygui", "with-unity-transport", "with-vfx-graph"]},
        "report": {"type": ["string", "null"]},
        "reportSha256": {"anyOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]},
        "passed": {"type": "boolean"},
        "required": {"const": true},
        "eligible": {"type": "boolean"},
        "schemaValid": {"type": "boolean"},
        "artifactHashValid": {"type": "boolean"},
        "mutationClean": {"type": "boolean"},
        "testsComplete": {"type": "boolean"},
        "logsClean": {"type": "boolean"},
        "candidateEqual": {"type": "boolean"},
        "failureReason": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    }
  }
}
