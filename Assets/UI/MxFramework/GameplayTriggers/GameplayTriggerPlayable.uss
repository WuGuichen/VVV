.gt-root {
    flex-grow: 1;
    flex-direction: row;
    color: rgb(238, 243, 248);
}

.gt-world-spacer {
    flex-grow: 1;
}

.gt-panel {
    width: 430px;
    min-width: 430px;
    margin-right: 20px;
    margin-top: 18px;
    margin-bottom: 18px;
    padding-left: 18px;
    padding-right: 18px;
    padding-top: 16px;
    padding-bottom: 14px;
    background-color: rgba(14, 18, 25, 0.94);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(62, 79, 98);
    border-right-color: rgb(62, 79, 98);
    border-top-color: rgb(62, 79, 98);
    border-bottom-color: rgb(62, 79, 98);
    border-radius: 8px;
}

.gt-header {
    min-height: 52px;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
}

.gt-title {
    font-size: 21px;
    -unity-font-style: bold;
    color: rgb(248, 250, 252);
}

.gt-subtitle {
    margin-top: 3px;
    font-size: 11px;
    color: rgb(142, 159, 177);
}

.gt-frame {
    min-width: 76px;
    height: 28px;
    padding-left: 8px;
    padding-right: 8px;
    background-color: rgb(33, 53, 70);
    color: rgb(202, 233, 255);
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    border-radius: 4px;
}

.gt-section {
    margin-bottom: 12px;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 10px;
    padding-bottom: 10px;
    background-color: rgb(24, 30, 39);
    border-radius: 5px;
}

.gt-section-title {
    margin-bottom: 6px;
    font-size: 10px;
    -unity-font-style: bold;
    color: rgb(115, 160, 197);
}

.gt-row {
    min-height: 29px;
    flex-direction: row;
    align-items: center;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.06);
}

.gt-key {
    width: 102px;
    color: rgb(151, 163, 177);
    font-size: 12px;
}

.gt-value {
    flex-grow: 1;
    color: rgb(238, 243, 248);
    font-size: 13px;
    -unity-font-style: bold;
}

.gt-badge {
    min-width: 150px;
    height: 23px;
    padding-left: 9px;
    padding-right: 9px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    border-radius: 4px;
}

.mx-status-badge--neutral {
    background-color: rgb(48, 56, 67);
    color: rgb(205, 214, 224);
}

.mx-status-badge--positive {
    background-color: rgb(31, 86, 66);
    color: rgb(198, 255, 226);
}

.mx-status-badge--warning {
    background-color: rgb(104, 77, 28);
    color: rgb(255, 233, 178);
}

.mx-status-badge--danger {
    background-color: rgb(105, 43, 47);
    color: rgb(255, 205, 208);
}

.gt-controls {
    flex-direction: row;
    margin-bottom: 9px;
}

.gt-button {
    flex-grow: 1;
    height: 34px;
    margin-right: 7px;
    background-color: rgb(46, 58, 72);
    color: rgb(239, 244, 248);
    -unity-font-style: bold;
    border-radius: 4px;
}

.gt-button:hover {
    background-color: rgb(61, 78, 96);
}

.gt-move {
    background-color: rgb(35, 73, 91);
}

.mx-command-button--hot {
    background-color: rgb(30, 104, 91);
}

.gt-danger {
    background-color: rgb(92, 43, 48);
}

.gt-event {
    min-height: 41px;
    white-space: normal;
    color: rgb(213, 224, 234);
    font-size: 11px;
}

.gt-hash {
    margin-top: 7px;
    color: rgb(133, 190, 228);
    font-size: 11px;
}

.gt-save {
    margin-top: 4px;
    color: rgb(184, 198, 212);
    font-size: 11px;
}

.gt-instructions {
    margin-top: 1px;
    white-space: normal;
    color: rgb(225, 230, 236);
    font-size: 11px;
    -unity-font-style: bold;
}

.gt-footnote {
    margin-top: 5px;
    white-space: normal;
    color: rgb(116, 132, 149);
    font-size: 10px;
}
